{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Chạy Web Foodie (HTTP - Port 5262)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/baitaplontmdtwebdatdoan/bin/Debug/net8.0/baitaplontmdtwebdatdoan.dll",
            "args": [],
            "cwd": "${workspaceFolder}/baitaplontmdtwebdatdoan",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5262"
            }
        }
    ]
}

