@model baitaplontmdtwebdatdoan.Models.MenuItemFormViewModel
@{
    ViewData["Title"] = "Chỉnh sửa món ăn - " + Model.Name;
    var categories = ViewBag.Categories as List<baitaplontmdtwebdatdoan.Models.MenuCategory> ?? new List<baitaplontmdtwebdatdoan.Models.MenuCategory>();
}

<div class="mb-4">
    <a asp-controller="RestaurantOwner" asp-action="Menu" class="text-decoration-none text-muted small fw-semibold">
        <i class="fa-solid fa-arrow-left me-1"></i> Quay lại thực đơn
    </a>
    <h4 class="fw-bold mt-2">Chỉnh sửa món: @Model.Name</h4>
</div>

<div class="bg-white rounded-4 shadow-sm p-4" style="max-width:750px">
    <form asp-controller="RestaurantOwner" asp-action="EditMenuItem" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-semibold small">Tên món ăn <span class="text-danger">*</span></label>
            <input asp-for="Name" class="form-control rounded-3" placeholder="VD: Cơm tấm sườn bì chả, Trà sữa trân châu..." />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="BasePrice" class="form-label fw-semibold small">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                <div class="input-group">
                    <input asp-for="BasePrice" type="number" step="1000" class="form-control rounded-start-3" />
                    <span class="input-group-text rounded-end-3">đ</span>
                </div>
                <span asp-validation-for="BasePrice" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="CategoryId" class="form-label fw-semibold small">Danh mục</label>
                <select asp-for="CategoryId" class="form-select rounded-3">
                    <option value="">-- Chọn danh mục --</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id)">@cat.Name</option>
                    }
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="NewCategoryName" class="form-label fw-semibold small">Hoặc chuyển sang danh mục mới</label>
            <input asp-for="NewCategoryName" class="form-control rounded-3" placeholder="Nhập tên danh mục mới nếu muốn..." />
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label fw-semibold small">Mô tả món ăn</label>
            <textarea asp-for="Description" class="form-control rounded-3" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <!-- IMAGE UPLOAD / URL -->
        <div class="mb-3 p-3 bg-light rounded-4 border">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <label class="form-label fw-semibold small mb-0">
                    <i class="fa-regular fa-images me-1 text-brand"></i> Hình ảnh món ăn (Cho phép nhiều ảnh)
                </label>
                <span class="badge bg-brand-subtle text-brand small">Ảnh đầu tiên sẽ là Ảnh đại diện chính</span>
            </div>
            
            <div class="mb-3">
                <label asp-for="ImageFiles" class="form-label small text-muted">1. Tải thêm ảnh từ máy tính (giữ phím Ctrl / Shift để chọn nhiều ảnh)</label>
                <input asp-for="ImageFiles" type="file" multiple accept="image/*" class="form-control" id="imageFilesInput" />
            </div>

            <div class="mb-3">
                <label asp-for="ImageUrl" class="form-label small text-muted">2. Đường dẫn các ảnh hiện tại / URL ảnh Online (cách nhau bởi dấu phẩy)</label>
                <textarea asp-for="ImageUrl" class="form-control form-control-sm font-monospace" rows="2" id="imageUrlInput"></textarea>
                <div class="form-text small">Bạn có thể chỉnh sửa, thêm hoặc xóa bớt đường dẫn ảnh trong ô trên.</div>
            </div>

            <!-- MULTI-IMAGE PREVIEWS -->
            <div>
                <div class="small fw-semibold text-muted mb-2">Hình ảnh hiện tại & xem trước:</div>
                <div id="multiImagePreviewContainer" class="d-flex flex-wrap gap-2">
                    @{
                        var currentImages = !string.IsNullOrWhiteSpace(Model.ImageUrl)
                            ? Model.ImageUrl.Split(new[] { ',', ';', '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList()
                            : new List<string>();
                    }
                    @if (currentImages.Count > 0)
                    {
                        for (int i = 0; i < currentImages.Count; i++)
                        {
                            var img = currentImages[i];
                            <div class="position-relative border rounded-3 p-1 bg-white shadow-sm" style="width:110px">
                                <img src="@img" class="rounded-2 object-fit-cover w-100" style="height:90px" alt="Ảnh @(i + 1)" onerror="this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=300';" />
                                <span class="badge @(i == 0 ? "bg-brand" : "bg-dark") position-absolute top-0 start-0 m-1" style="font-size:10px">@(i == 0 ? "Ảnh chính" : $"#{i + 1}")</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="position-relative border rounded-3 p-1 bg-white shadow-sm" style="width:110px">
                            <img src="https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=300" class="rounded-2 object-fit-cover w-100" style="height:90px" alt="Chưa có ảnh" />
                            <span class="badge bg-secondary position-absolute top-0 start-0 m-1" style="font-size:10px">Mặc định</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- CHECKBOXES -->
        <div class="row g-3 mb-4">
            <div class="col-sm-6">
                <div class="form-check form-switch">
                    <input asp-for="IsAvailable" class="form-check-input" type="checkbox" role="switch" />
                    <label asp-for="IsAvailable" class="form-check-label fw-semibold small">Mở bán (Còn hàng)</label>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-check form-switch">
                    <input asp-for="IsBestSeller" class="form-check-input" type="checkbox" role="switch" />
                    <label asp-for="IsBestSeller" class="form-check-label fw-semibold small">Gắn nhãn Món nổi bật / Best Seller</label>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="RestaurantOwner" asp-action="Menu" class="btn btn-outline-secondary px-4 fw-semibold rounded-3">Huỷ</a>
            <button type="submit" class="btn btn-brand px-5 fw-bold rounded-3 shadow-sm">
                <i class="fa-solid fa-floppy-disk me-1"></i> Cập nhật thay đổi
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const imageFilesInput = document.getElementById('imageFilesInput');
        const imageUrlInput = document.getElementById('imageUrlInput');
        const container = document.getElementById('multiImagePreviewContainer');

        function renderUrlPreviews(val) {
            const urls = val.split(/[,;\n]/).map(u => u.trim()).filter(u => u.length > 0);
            if (urls.length === 0) return;
            container.innerHTML = '';
            urls.forEach((src, idx) => {
                const card = document.createElement('div');
                card.className = 'position-relative border rounded-3 p-1 bg-white shadow-sm';
                card.style.width = '110px';
                const badgeText = idx === 0 ? 'Ảnh chính' : `#${idx + 1}`;
                const badgeClass = idx === 0 ? 'bg-brand' : 'bg-dark';
                card.innerHTML = `
                    <img src="${src}" class="rounded-2 object-fit-cover w-100" style="height:90px" alt="Ảnh ${idx + 1}" onerror="this.src='https://placehold.co/150x100?text=Error';" />
                    <span class="badge ${badgeClass} position-absolute top-0 start-0 m-1" style="font-size:10px">${badgeText}</span>
                `;
                container.appendChild(card);
            });
        }

        imageFilesInput.addEventListener('change', function(e) {
            const files = Array.from(e.target.files);
            if (files.length > 0) {
                container.innerHTML = '';
                files.forEach((file, idx) => {
                    const reader = new FileReader();
                    reader.onload = function(evt) {
                        const card = document.createElement('div');
                        card.className = 'position-relative border rounded-3 p-1 bg-white shadow-sm';
                        card.style.width = '110px';
                        const badgeText = idx === 0 ? 'Ảnh tải lên #1' : `Tải lên #${idx + 1}`;
                        card.innerHTML = `
                            <img src="${evt.target.result}" class="rounded-2 object-fit-cover w-100" style="height:90px" alt="Tải lên ${idx + 1}" />
                            <span class="badge bg-success position-absolute top-0 start-0 m-1" style="font-size:10px">${badgeText}</span>
                        `;
                        container.appendChild(card);
                    };
                    reader.readAsDataURL(file);
                });
            }
        });

        imageUrlInput.addEventListener('input', function(e) {
            if (!imageFilesInput.files || imageFilesInput.files.length === 0) {
                renderUrlPreviews(e.target.value);
            }
        });
    </script>
}
