@model List<baitaplontmdtwebdatdoan.Models.Order>
@{
    ViewData["Title"] = "Quản lý đơn hàng - " + ViewBag.RestaurantName;
    string currentStatus = ViewBag.CurrentStatus as string ?? "processing";
    var restaurant = ViewBag.Restaurant as baitaplontmdtwebdatdoan.Models.Restaurant;

    string GetStatusLabel(string status) => status switch
    {
        "pending" => "Chờ xác nhận",
        "confirmed" => "Đã xác nhận",
        "preparing" => "Đang chuẩn bị",
        "ready_for_pickup" => "Sẵn sàng giao",
        "picked_up" => "Tài xế đã lấy hàng",
        "delivering" => "Đang giao",
        "completed" => "Hoàn thành",
        "cancelled" => "Đã huỷ",
        _ => status
    };

    string GetStatusBadgeClass(string status) => status switch
    {
        "pending" => "bg-warning text-dark border border-warning",
        "confirmed" => "bg-info text-dark border border-info",
        "preparing" => "bg-primary-subtle text-primary border border-primary",
        "ready_for_pickup" => "bg-primary-subtle text-primary border border-primary",
        "delivering" => "bg-primary text-white",
        "completed" => "bg-success text-white",
        "cancelled" => "bg-danger-subtle text-danger border border-danger",
        _ => "bg-secondary text-white"
    };

    string GetPaymentMethodName(string method) => method switch
    {
        "cod" => "Tiền mặt (COD)",
        "bank_transfer" => "Chuyển khoản VietQR",
        "wallet" => "Ví Foodie",
        "credit_card" => "Thẻ Quốc tế",
        _ => method
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1">🍳 @ViewBag.RestaurantName</h4>
        @if (ViewBag.RestaurantStatus == "pending_approval")
        {
            <span class="badge bg-warning text-dark"><i class="fa-solid fa-clock me-1"></i>Đang chờ admin duyệt</span>
        }
        else
        {
            <span class="badge bg-success"><i class="fa-solid fa-circle-check me-1"></i>Đang hoạt động</span>
        }
    </div>
    <div>
        <a asp-controller="RestaurantOwner" asp-action="CreateMenuItem" class="btn btn-brand fw-bold px-3 py-2 rounded-3 shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> Thêm món mới
        </a>
    </div>
</div>

<!-- TABS NAVIGATION -->
<ul class="nav nav-pills mb-4 bg-white p-2 rounded-4 shadow-sm" style="width:fit-content">
    <li class="nav-item">
        <a class="nav-link active bg-brand text-white fw-semibold px-4 rounded-3" asp-controller="RestaurantOwner" asp-action="Orders">
            <i class="fa-solid fa-receipt me-2"></i>Đơn hàng
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark fw-semibold px-4 rounded-3" asp-controller="RestaurantOwner" asp-action="Menu">
            <i class="fa-solid fa-utensils me-2"></i>Thực đơn món ăn
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark fw-semibold px-4 rounded-3" asp-controller="RestaurantOwner" asp-action="Revenue">
            <i class="fa-solid fa-chart-line me-2 text-success"></i>Doanh thu & Tài chính
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark fw-semibold px-4 rounded-3" asp-controller="Chat" asp-action="ShopInbox">
            <i class="fa-regular fa-comments me-2 text-primary"></i>Tin nhắn khách
        </a>
    </li>
</ul>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- TOAST THÔNG BÁO ĐƠN MỚI REALTIME -->
<div class="alert alert-warning border-warning shadow-sm rounded-4 mb-4 d-flex align-items-center justify-content-between" id="newOrderAlert" style="display:none !important;">
    <div class="d-flex align-items-center gap-2">
        <i class="fa-solid fa-bell fa-shake text-danger fs-4"></i>
        <div>
            <strong class="text-dark">Có đơn hàng mới vừa được đặt!</strong>
            <div class="text-muted small" id="newOrderText">Mã đơn: #...</div>
        </div>
    </div>
    <button type="button" class="btn btn-sm btn-brand fw-bold rounded-3" onclick="location.reload()">
        <i class="fa-solid fa-rotate me-1"></i> Tải lại danh sách
    </button>
</div>

<!-- TABS LỌC THEO TRẠNG THÁI ĐƠN HÀNG -->
<ul class="nav nav-pills mb-4 bg-white p-2 rounded-4 shadow-sm overflow-auto flex-nowrap" style="width:100%">
    <li class="nav-item flex-shrink-0">
        <a class="nav-link px-3 py-2 rounded-3 fw-semibold @(currentStatus == "processing" ? "active bg-brand text-white" : "text-dark")" 
           asp-controller="RestaurantOwner" asp-action="Orders" asp-route-status="processing">
            <i class="fa-solid fa-fire-burner me-1"></i> Cần chế biến
        </a>
    </li>
    <li class="nav-item flex-shrink-0">
        <a class="nav-link px-3 py-2 rounded-3 fw-semibold @(currentStatus == "shipping" ? "active bg-brand text-white" : "text-dark")" 
           asp-controller="RestaurantOwner" asp-action="Orders" asp-route-status="shipping">
            <i class="fa-solid fa-truck-fast me-1"></i> Đang giao hàng
        </a>
    </li>
    <li class="nav-item flex-shrink-0">
        <a class="nav-link px-3 py-2 rounded-3 fw-semibold @(currentStatus == "completed" ? "active bg-brand text-white" : "text-dark")" 
           asp-controller="RestaurantOwner" asp-action="Orders" asp-route-status="completed">
            <i class="fa-solid fa-circle-check me-1"></i> Đã hoàn thành
        </a>
    </li>
    <li class="nav-item flex-shrink-0">
        <a class="nav-link px-3 py-2 rounded-3 fw-semibold @(currentStatus == "cancelled" ? "active bg-brand text-white" : "text-dark")" 
           asp-controller="RestaurantOwner" asp-action="Orders" asp-route-status="cancelled">
            <i class="fa-solid fa-circle-xmark me-1"></i> Đã huỷ
        </a>
    </li>
    <li class="nav-item flex-shrink-0">
        <a class="nav-link px-3 py-2 rounded-3 fw-semibold @(currentStatus == "all" ? "active bg-brand text-white" : "text-dark")" 
           asp-controller="RestaurantOwner" asp-action="Orders" asp-route-status="all">
            Tất cả đơn
        </a>
    </li>
</ul>

@if (!Model.Any())
{
    <div class="bg-white rounded-4 p-5 text-center shadow-sm">
        <i class="fa-solid fa-receipt text-muted fs-1 mb-3 opacity-50"></i>
        <h5 class="fw-bold">Hiện không có đơn hàng nào trong mục này</h5>
        <p class="text-muted small mb-0">Hệ thống sẽ tự động cập nhật khi có đơn hàng mới phát sinh.</p>
    </div>
}
else
{
    <div class="d-flex flex-column gap-4">
        @foreach (var o in Model)
        {
            var receiver = o.DeliveryAddress?.ReceiverName ?? o.User?.FullName ?? "Khách hàng";
            var phone = o.DeliveryAddress?.ReceiverPhone ?? o.User?.Phone ?? "Chưa có";
            var address = o.DeliveryAddress?.AddressLine ?? "Nhận tại quán";

            <div class="bg-white rounded-4 shadow-sm p-4 border border-light-subtle">
                <!-- HEADER ĐƠN -->
                <div class="d-flex flex-wrap justify-content-between align-items-center pb-3 border-bottom gap-2">
                    <div>
                        <span class="fs-5 fw-bold text-dark me-2">#@o.OrderCode</span>
                        <span class="badge @GetStatusBadgeClass(o.OrderStatus) px-3 py-1 rounded-pill small">
                            @GetStatusLabel(o.OrderStatus)
                        </span>
                        <span class="badge @(o.PaymentStatus == "paid" ? "bg-success" : "bg-secondary") px-2 py-1 rounded-pill small ms-1">
                            @(o.PaymentStatus == "paid" ? "Đã thanh toán" : "Chưa thanh toán") (@GetPaymentMethodName(o.PaymentMethod))
                        </span>
                    </div>
                    <div class="text-muted small">
                        <i class="fa-regular fa-clock me-1"></i>Đặt lúc: @o.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>

                <!-- BODY: THÔNG TIN KHÁCH & MÓN ĂN -->
                <div class="row g-4 py-3">
                    <!-- KHỐI KHÁCH HÀNG & GIAO HÀNG -->
                    <div class="col-lg-5 border-end-lg">
                        <h6 class="fw-bold text-muted text-uppercase small mb-2"><i class="fa-solid fa-location-dot text-danger me-1"></i>Thông tin người nhận</h6>
                        <div class="mb-1">
                            <strong class="text-dark">@receiver</strong> — <span class="text-primary fw-semibold"><i class="fa-solid fa-phone me-1 small"></i>@phone</span>
                        </div>
                        <div class="text-muted small mb-2">
                            <i class="fa-solid fa-house me-1"></i>@address
                        </div>
                        @if (!string.IsNullOrWhiteSpace(o.Note))
                        {
                            <div class="p-2 rounded-3 bg-light text-danger small border-start border-3 border-warning">
                                <strong>Ghi chú của khách:</strong> @o.Note
                            </div>
                        }
                    </div>

                    <!-- KHỐI DANH SÁCH MÓN ĂN -->
                    <div class="col-lg-7">
                        <h6 class="fw-bold text-muted text-uppercase small mb-2"><i class="fa-solid fa-utensils text-brand me-1"></i>Chi tiết món ăn cần chuẩn bị</h6>
                        <div class="table-responsive">
                            <table class="table table-sm table-borderless align-middle mb-0">
                                <tbody>
                                    @foreach (var it in o.OrderItems)
                                    {
                                        <tr class="border-bottom">
                                            <td style="width:40px">
                                                <img src="@(string.IsNullOrEmpty(it.MenuItem?.ImageUrl) ? "https://placehold.co/60x60?text=Food" : it.MenuItem.ImageUrl)"
                                                     class="rounded-2 object-fit-cover shadow-xs" width="36" height="36" alt="@it.ItemName" 
                                                     onerror="this.src='https://placehold.co/60x60?text=Food';" />
                                            </td>
                                            <td>
                                                <div class="fw-bold text-dark small">@it.ItemName</div>
                                                <div class="text-muted" style="font-size:11px">@it.UnitPrice.ToString("N0")đ/phần</div>
                                            </td>
                                            <td class="text-center fw-bold text-brand fs-6">
                                                x@it.Quantity
                                            </td>
                                            <td class="text-end fw-bold text-dark small">
                                                @it.LineTotal.ToString("N0")đ
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- FOOTER: TỔNG TIỀN VÀ CẬP NHẬT TRẠNG THÁI -->
                <div class="pt-3 border-top d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div>
                            <span class="text-muted small">Tổng thu tiền món: </span>
                            <span class="fs-5 fw-bold text-brand">@o.TotalAmount.ToString("N0")đ</span>
                        </div>
                        @if (o.DiscountAmount > 0)
                        {
                            <span class="badge bg-success-subtle text-success small">Đã giảm voucher: @o.DiscountAmount.ToString("N0")đ</span>
                        }
                    </div>

                    <!-- FORM CẬP NHẬT TRẠNG THÁI -->
                    <form asp-controller="RestaurantOwner" asp-action="UpdateStatus" method="post" class="d-flex align-items-center gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@o.Id" />
                        <label class="small text-muted fw-semibold flex-shrink-0 d-none d-sm-inline">Trạng thái:</label>
                        <select name="newStatus" class="form-select form-select-sm rounded-3 fw-semibold">
                            <option value="pending" selected="@(o.OrderStatus == "pending")">Chờ xác nhận</option>
                            <option value="confirmed" selected="@(o.OrderStatus == "confirmed")">Đã xác nhận</option>
                            <option value="preparing" selected="@(o.OrderStatus == "preparing")">Đang chuẩn bị món</option>
                            <option value="ready_for_pickup" selected="@(o.OrderStatus == "ready_for_pickup")">Sẵn sàng giao</option>
                            <option value="delivering" selected="@(o.OrderStatus == "delivering")">Đang giao</option>
                            <option value="completed" selected="@(o.OrderStatus == "completed")">Đã giao thành công</option>
                            <option value="cancelled" selected="@(o.OrderStatus == "cancelled")">Huỷ đơn</option>
                        </select>
                        <button type="submit" class="btn btn-sm btn-brand fw-bold px-3 py-1 rounded-3 flex-shrink-0">
                            Cập nhật
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        const restId = "@(restaurant?.Id ?? 0)";
        if (restId && restId !== "0") {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/orderHub")
                .withAutomaticReconnect()
                .build();

            connection.on("NewOrderReceived", function (orderId, orderCode, totalAmount) {
                const alertEl = document.getElementById("newOrderAlert");
                const textEl = document.getElementById("newOrderText");
                if (alertEl && textEl) {
                    textEl.innerText = `Đơn #${orderCode} - ${Number(totalAmount).toLocaleString('vi-VN')}đ`;
                    alertEl.style.setProperty("display", "flex", "important");
                }
            });

            connection.start().then(function () {
                connection.invoke("JoinRestaurantGroup", restId);
            });
        }
    </script>
}