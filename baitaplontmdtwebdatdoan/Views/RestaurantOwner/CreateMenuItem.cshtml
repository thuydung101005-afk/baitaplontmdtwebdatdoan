@model baitaplontmdtwebdatdoan.Models.MenuItemFormViewModel
@{
    ViewData["Title"] = "Thêm món mới vào thực đơn";
    var categories = ViewBag.Categories as List<baitaplontmdtwebdatdoan.Models.MenuCategory> ?? new List<baitaplontmdtwebdatdoan.Models.MenuCategory>();
}

<div class="mb-4">
    <a asp-controller="RestaurantOwner" asp-action="Menu" class="text-decoration-none text-muted small fw-semibold">
        <i class="fa-solid fa-arrow-left me-1"></i> Quay lại thực đơn
    </a>
    <h4 class="fw-bold mt-2">Thêm món ăn mới</h4>
</div>

<div class="bg-white rounded-4 shadow-sm p-4" style="max-width:750px">
    <form asp-controller="RestaurantOwner" asp-action="CreateMenuItem" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-semibold small">Tên món ăn <span class="text-danger">*</span></label>
            <input asp-for="Name" class="form-control rounded-3" placeholder="VD: Cơm tấm sườn bì chả, Trà sữa trân châu..." />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="BasePrice" class="form-label fw-semibold small">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                <div class="input-group">
                    <input asp-for="BasePrice" type="number" step="1000" class="form-control rounded-start-3" placeholder="VD: 35000" />
                    <span class="input-group-text rounded-end-3">đ</span>
                </div>
                <span asp-validation-for="BasePrice" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="CategoryId" class="form-label fw-semibold small">Danh mục hiện có</label>
                <select asp-for="CategoryId" class="form-select rounded-3">
                    <option value="">-- Chọn danh mục --</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="NewCategoryName" class="form-label fw-semibold small">Hoặc thêm danh mục mới (nếu chưa có)</label>
            <input asp-for="NewCategoryName" class="form-control rounded-3" placeholder="VD: Món tráng miệng, Nước ép..." />
            <div class="form-text small text-muted">Nếu nhập danh mục mới, hệ thống sẽ tự động tạo danh mục cho quán của bạn.</div>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label fw-semibold small">Mô tả món ăn</label>
            <textarea asp-for="Description" class="form-control rounded-3" rows="3" placeholder="Mô tả nguyên liệu, hương vị món ăn..."></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <!-- IMAGE UPLOAD / URL -->
        <div class="mb-3 p-3 bg-light rounded-4 border">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <label class="form-label fw-semibold small mb-0">
                    <i class="fa-regular fa-images me-1 text-brand"></i> Hình ảnh món ăn (Cho phép tải nhiều ảnh)
                </label>
                <span class="badge bg-brand-subtle text-brand small">Ảnh đầu tiên sẽ là Ảnh chính</span>
            </div>
            
            <div class="mb-3">
                <label asp-for="ImageFiles" class="form-label small text-muted">1. Tải ảnh từ máy tính (giữ phím Ctrl / Shift để chọn nhiều ảnh cùng lúc)</label>
                <input asp-for="ImageFiles" type="file" multiple accept="image/*" class="form-control" id="imageFilesInput" />
            </div>

            <div class="mb-3">
                <label asp-for="ImageUrl" class="form-label small text-muted">2. Hoặc dán liên kết URL ảnh Online (nếu nhiều ảnh, cách nhau bằng dấu phẩy)</label>
                <input asp-for="ImageUrl" class="form-control form-control-sm" placeholder="https://..., https://..." id="imageUrlInput" />
            </div>

            <!-- MULTI-IMAGE PREVIEW GRID -->
            <div>
                <div class="small fw-semibold text-muted mb-2">Danh sách ảnh xem trước:</div>
                <div id="multiImagePreviewContainer" class="d-flex flex-wrap gap-2">
                    <div class="position-relative border rounded-3 p-1 bg-white shadow-sm" style="width:110px">
                        <img src="https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=300" class="rounded-2 object-fit-cover w-100" style="height:90px" alt="Xem trước mặc định" />
                        <span class="badge bg-secondary position-absolute top-0 start-0 m-1 small" style="font-size:10px">Mẫu</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- CHECKBOXES -->
        <div class="row g-3 mb-4">
            <div class="col-sm-6">
                <div class="form-check form-switch">
                    <input asp-for="IsAvailable" class="form-check-input" type="checkbox" role="switch" checked />
                    <label asp-for="IsAvailable" class="form-check-label fw-semibold small">Mở bán ngay lập tức</label>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-check form-switch">
                    <input asp-for="IsBestSeller" class="form-check-input" type="checkbox" role="switch" />
                    <label asp-for="IsBestSeller" class="form-check-label fw-semibold small">Gắn nhãn Món nổi bật / Best Seller</label>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="RestaurantOwner" asp-action="Menu" class="btn btn-outline-secondary px-4 fw-semibold rounded-3">Huỷ</a>
            <button type="submit" class="btn btn-brand px-5 fw-bold rounded-3 shadow-sm">
                <i class="fa-solid fa-check me-1"></i> Lưu món ăn
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const imageFilesInput = document.getElementById('imageFilesInput');
        const imageUrlInput = document.getElementById('imageUrlInput');
        const container = document.getElementById('multiImagePreviewContainer');

        function renderPreviews(sources) {
            if (!sources || sources.length === 0) return;
            container.innerHTML = '';
            sources.forEach((src, idx) => {
                const card = document.createElement('div');
                card.className = 'position-relative border rounded-3 p-1 bg-white shadow-sm';
                card.style.width = '110px';
                
                const badgeText = idx === 0 ? 'Ảnh chính' : `#${idx + 1}`;
                const badgeClass = idx === 0 ? 'bg-brand' : 'bg-dark';

                card.innerHTML = `
                    <img src="${src}" class="rounded-2 object-fit-cover w-100" style="height:90px" alt="Preview ${idx + 1}" onerror="this.src='https://placehold.co/150x100?text=Error';" />
                    <span class="badge ${badgeClass} position-absolute top-0 start-0 m-1" style="font-size:10px">${badgeText}</span>
                `;
                container.appendChild(card);
            });
        }

        imageFilesInput.addEventListener('change', function(e) {
            const files = Array.from(e.target.files);
            if (files.length > 0) {
                container.innerHTML = '';
                files.forEach((file, idx) => {
                    const reader = new FileReader();
                    reader.onload = function(evt) {
                        const card = document.createElement('div');
                        card.className = 'position-relative border rounded-3 p-1 bg-white shadow-sm';
                        card.style.width = '110px';
                        const badgeText = idx === 0 ? 'Ảnh chính' : `#${idx + 1}`;
                        const badgeClass = idx === 0 ? 'bg-brand' : 'bg-dark';
                        card.innerHTML = `
                            <img src="${evt.target.result}" class="rounded-2 object-fit-cover w-100" style="height:90px" alt="Ảnh ${idx + 1}" />
                            <span class="badge ${badgeClass} position-absolute top-0 start-0 m-1" style="font-size:10px">${badgeText}</span>
                        `;
                        container.appendChild(card);
                    };
                    reader.readAsDataURL(file);
                });
            }
        });

        imageUrlInput.addEventListener('input', function(e) {
            const val = e.target.value.trim();
            if (val) {
                const urls = val.split(/[,;\n]/).map(u => u.trim()).filter(u => u.length > 0);
                if (urls.length > 0 && (!imageFilesInput.files || imageFilesInput.files.length === 0)) {
                    renderPreviews(urls);
                }
            }
        });
    </script>
}
