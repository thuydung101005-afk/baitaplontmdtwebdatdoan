@model List<baitaplontmdtwebdatdoan.Models.MenuItem>
@{
    ViewData["Title"] = "Quản lý thực đơn - " + ViewBag.RestaurantName;
    var categories = ViewBag.Categories as List<baitaplontmdtwebdatdoan.Models.MenuCategory> ?? new List<baitaplontmdtwebdatdoan.Models.MenuCategory>();
    long? selectedCatId = ViewBag.SelectedCategoryId;
    string? searchKeyword = ViewBag.SearchKeyword;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1">🍳 @ViewBag.RestaurantName</h4>
        @if (ViewBag.RestaurantStatus == "pending_approval")
        {
            <span class="badge bg-warning text-dark"><i class="fa-solid fa-clock me-1"></i>Đang chờ admin duyệt</span>
        }
        else
        {
            <span class="badge bg-success"><i class="fa-solid fa-circle-check me-1"></i>Đang hoạt động</span>
        }
    </div>
    <div>
        <a asp-controller="RestaurantOwner" asp-action="CreateMenuItem" class="btn btn-brand fw-bold px-3 py-2 rounded-3 shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> Thêm món mới
        </a>
    </div>
</div>

<!-- TABS NAVIGATION -->
<ul class="nav nav-pills mb-4 bg-white p-2 rounded-4 shadow-sm" style="width:fit-content">
    <li class="nav-item">
        <a class="nav-link text-dark fw-semibold px-4 rounded-3" asp-controller="RestaurantOwner" asp-action="Orders">
            <i class="fa-solid fa-receipt me-2"></i>Đơn hàng
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link active bg-brand text-white fw-semibold px-4 rounded-3" asp-controller="RestaurantOwner" asp-action="Menu">
            <i class="fa-solid fa-utensils me-2"></i>Thực đơn món ăn
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark fw-semibold px-4 rounded-3" asp-controller="RestaurantOwner" asp-action="Revenue">
            <i class="fa-solid fa-chart-line me-2 text-success"></i>Doanh thu & Tài chính
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark fw-semibold px-4 rounded-3" asp-controller="Chat" asp-action="ShopInbox">
            <i class="fa-regular fa-comments me-2 text-primary"></i>Tin nhắn khách
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark fw-semibold px-4 rounded-3" asp-controller="RestaurantOwner" asp-action="Settings">
            <i class="fa-solid fa-gear me-2"></i>Hồ sơ & Ảnh nhà hàng
        </a>
    </li>
</ul>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- STATS OVERVIEW -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4">
        <div class="bg-white rounded-4 p-3 shadow-sm border-start border-4 border-primary">
            <div class="text-muted small">Tổng số món</div>
            <div class="fs-4 fw-bold text-dark">@ViewBag.TotalCount</div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="bg-white rounded-4 p-3 shadow-sm border-start border-4 border-success">
            <div class="text-muted small">Đang mở bán</div>
            <div class="fs-4 fw-bold text-success">@ViewBag.AvailableCount</div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="bg-white rounded-4 p-3 shadow-sm border-start border-4 border-secondary">
            <div class="text-muted small">Tạm hết món</div>
            <div class="fs-4 fw-bold text-secondary">@ViewBag.OutOfStockCount</div>
        </div>
    </div>
</div>

<!-- SEARCH & FILTER -->
<div class="bg-white rounded-4 p-3 shadow-sm mb-4">
    <form asp-controller="RestaurantOwner" asp-action="Menu" method="get" class="row g-2 align-items-center">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-light border-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                <input type="text" name="search" value="@searchKeyword" class="form-control bg-light border-0" placeholder="Tìm tên món trong quán..." />
            </div>
        </div>
        <div class="col-md-4">
            <select name="categoryId" class="form-select bg-light border-0">
                <option value="">-- Tất cả danh mục (@categories.Count) --</option>
                @foreach (var cat in categories)
                {
                    <option value="@cat.Id" selected="@(selectedCatId == cat.Id)">@cat.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-outline-brand flex-fill fw-bold">Lọc</button>
            @if (selectedCatId.HasValue || !string.IsNullOrEmpty(searchKeyword))
            {
                <a asp-controller="RestaurantOwner" asp-action="Menu" class="btn btn-light text-muted">Xoá lọc</a>
            }
        </div>
    </form>
</div>

<!-- MENU ITEMS TABLE -->
<div class="bg-white rounded-4 shadow-sm overflow-hidden mb-4">
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fa-solid fa-bowl-food text-muted fs-1 mb-3 opacity-50"></i>
            <h6 class="fw-bold text-muted">Chưa có món ăn nào trong danh mục này</h6>
            <p class="small text-muted mb-3">Hãy bổ sung món ăn vào thực đơn để khách hàng bắt đầu đặt hàng nhé!</p>
            <a asp-controller="RestaurantOwner" asp-action="CreateMenuItem" class="btn btn-brand btn-sm fw-bold">
                <i class="fa-solid fa-plus me-1"></i> Thêm món ngay
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:80px">Ảnh</th>
                        <th>Tên món ăn</th>
                        <th>Danh mục</th>
                        <th>Giá bán</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=150" : item.ImageUrl)" 
                                     class="rounded-3 object-fit-cover shadow-sm" 
                                     style="width:60px; height:60px" 
                                     alt="@item.Name" 
                                     onerror="this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=150';" />
                            </td>
                            <td>
                                <div class="fw-bold text-dark">
                                    @item.Name
                                    @if (item.IsBestSeller)
                                    {
                                        <span class="badge bg-warning text-dark small ms-1"><i class="fa-solid fa-fire me-1 text-danger"></i>Best Seller</span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <div class="text-muted small text-truncate" style="max-width:320px">@item.Description</div>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @(item.Category?.Name ?? "Chưa phân loại")
                                </span>
                            </td>
                            <td>
                                <span class="fw-bold text-brand">@item.BasePrice.ToString("N0")đ</span>
                            </td>
                            <td>
                                <form asp-controller="RestaurantOwner" asp-action="ToggleItemStatus" asp-route-id="@item.Id" method="post" class="d-inline">
                                    @if (item.IsAvailable)
                                    {
                                        <button type="submit" class="badge bg-success-subtle text-success border border-success px-2 py-1 rounded-pill text-decoration-none" title="Nhấn để chuyển sang Tạm hết">
                                            <i class="fa-solid fa-check me-1"></i>Đang bán
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="badge bg-secondary-subtle text-secondary border border-secondary px-2 py-1 rounded-pill text-decoration-none" title="Nhấn để chuyển sang Đang bán">
                                            <i class="fa-solid fa-ban me-1"></i>Tạm hết
                                        </button>
                                    }
                                </form>
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group">
                                    <a asp-controller="RestaurantOwner" asp-action="EditMenuItem" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary rounded-2 me-1" title="Chỉnh sửa">
                                        <i class="fa-solid fa-pen-to-square"></i> Sửa
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-2" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Id" title="Xoá món">
                                        <i class="fa-regular fa-trash-can"></i>
                                    </button>
                                </div>

                                <!-- Modal xác nhận xoá -->
                                <div class="modal fade" id="deleteModal-@item.Id" tabindex="-1">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content rounded-4 text-start">
                                            <div class="modal-body p-4 text-center">
                                                <i class="fa-solid fa-triangle-exclamation text-danger fs-1 mb-3"></i>
                                                <h5 class="fw-bold">Xoá món ăn?</h5>
                                                <p class="text-muted small">Bạn có chắc chắn muốn xoá món <strong>@item.Name</strong> khỏi thực đơn? Món này sẽ không còn hiển thị cho khách đặt hàng.</p>
                                                <div class="d-flex gap-2 mt-4 justify-content-center">
                                                    <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Huỷ</button>
                                                    <form asp-controller="RestaurantOwner" asp-action="DeleteMenuItem" asp-route-id="@item.Id" method="post">
                                                        <button type="submit" class="btn btn-danger fw-bold px-4">Xoá món</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
