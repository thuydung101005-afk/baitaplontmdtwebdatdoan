@{
    ViewData["Title"] = "Tạo hồ sơ nhà hàng";
}

<div class="bg-white rounded-4 shadow-sm p-4" style="max-width:500px">
    <h5 class="fw-bold mb-3">Tạo hồ sơ nhà hàng của bạn</h5>
    <p class="text-muted small">Bạn cần tạo hồ sơ nhà hàng trước khi có thể nhận đơn và quản lý thực đơn.</p>

    <form method="post">
        <div class="mb-3">
            <label class="form-label small fw-semibold">Tên nhà hàng</label>
            <input type="text" name="name" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label small fw-semibold">Địa chỉ</label>
            <input type="text" name="address" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label small fw-semibold">Số điện thoại</label>
            <input type="text" name="phone" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label small fw-semibold">Đơn tối thiểu (đ)</label>
            <input type="number" name="minOrderAmount" class="form-control" value="20000" />
        </div>
        <div class="mb-3">
            <label class="form-label small fw-semibold">Thời gian chuẩn bị (phút)</label>
            <input type="number" name="prepTimeMinutes" class="form-control" value="20" />
        </div>
        <button type="submit" class="btn btn-brand w-100 fw-bold">Tạo hồ sơ</button>
    </form>
</div>