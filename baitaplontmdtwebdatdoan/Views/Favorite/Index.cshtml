@model List<baitaplontmdtwebdatdoan.Models.Favorite>
@{
    ViewData["Title"] = "Quán ăn yêu thích";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1 d-flex align-items-center gap-2">
            <i class="fa-solid fa-heart text-danger"></i>
            QUÁN ĂN YÊU THÍCH
            <span class="badge bg-danger-subtle text-danger fs-6 rounded-pill px-3 py-1 border border-danger">@Model.Count quán</span>
        </h4>
        <p class="text-muted small mb-0">Danh sách các quán ăn và nhà hàng bạn đã lưu để đặt món nhanh chóng</p>
    </div>
    @if (Model.Any())
    {
        <div class="position-relative" style="min-width: 260px;">
            <i class="fa-solid fa-magnifying-glass text-muted position-absolute top-50 start-0 translate-middle-y ms-3"></i>
            <input type="text" id="favSearchInput" class="form-control rounded-pill ps-5 bg-white border" placeholder="Tìm trong quán yêu thích..." />
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="bg-white rounded-4 p-5 text-center shadow-sm">
        <div class="d-inline-flex p-4 rounded-circle bg-danger-subtle text-danger fs-1 mb-3">
            <i class="fa-regular fa-heart"></i>
        </div>
        <h5 class="fw-bold mb-2">Chưa có quán ăn yêu thích nào</h5>
        <p class="text-muted small mb-4" style="max-width: 480px; margin: 0 auto;">
            Khi lướt xem các nhà hàng thơm ngon trên Foodie, hãy bấm vào biểu tượng trái tim để lưu lại quán ăn ruột của bạn nhé!
        </p>
        <div class="d-flex justify-content-center gap-2">
            <a asp-controller="Restaurant" asp-action="Index" class="btn btn-brand fw-bold px-4 py-2 rounded-3 shadow-sm">
                <i class="fa-solid fa-store me-2"></i>Khám phá nhà hàng
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary fw-semibold px-4 py-2 rounded-3">
                <i class="fa-solid fa-house me-1"></i>Trang chủ
            </a>
        </div>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4" id="favContainer">
        @foreach (var fav in Model)
        {
            var r = fav.Restaurant;
            <div class="col fav-card-item" data-name="@r.Name.ToLower()" data-address="@(r.Address?.ToLower() ?? "")">
                <div class="card fd-card shadow-sm h-100 border-0 rounded-4 overflow-hidden position-relative">
                    <!-- Ảnh bìa -->
                    <div class="position-relative" style="height: 180px; overflow: hidden;">
                        <img src="@(string.IsNullOrEmpty(r.CoverImageUrl) ? "https://placehold.co/400x250?text=Foodie+Restaurant" : r.CoverImageUrl)" 
                             class="w-100 h-100 object-fit-cover transition" alt="@r.Name"
                             onerror="this.src='https://placehold.co/400x250?text=Foodie+Restaurant';" />
                        
                        <!-- Badge Trạng thái mở cửa -->
                        <span class="badge @(r.Status == "open" ? "bg-success" : "bg-secondary") position-absolute top-0 start-0 m-3 px-3 py-2 rounded-pill shadow-xs" style="font-size: 11px;">
                            <i class="fa-solid fa-circle me-1" style="font-size: 8px;"></i>@(r.Status == "open" ? "Đang mở cửa" : "Đã đóng cửa")
                        </span>

                        <!-- Nút Thả tim bỏ yêu thích -->
                        <button type="button" class="btn btn-light rounded-circle shadow position-absolute top-0 end-0 m-3 d-flex align-items-center justify-content-center toggle-fav-btn is-favorited"
                                data-restaurant-id="@r.Id" style="width: 38px; height: 38px;" title="Bỏ yêu thích">
                            <i class="fa-solid fa-heart text-danger fs-6"></i>
                        </button>
                    </div>

                    <!-- Nội dung quán -->
                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="fw-bold mb-1 text-truncate">
                                <a asp-controller="Restaurant" asp-action="Details" asp-route-id="@r.Id" class="text-decoration-none text-dark hover-brand">
                                    @r.Name
                                </a>
                            </h5>
                            
                            <div class="d-flex align-items-center gap-3 text-muted small mb-2">
                                <span><i class="fa-solid fa-star text-warning me-1"></i><strong>@(r.AvgRating > 0 ? r.AvgRating.ToString("0.0") : "5.0")</strong> (@r.TotalReviews)</span>
                                <span><i class="fa-regular fa-clock me-1 text-brand"></i>@r.PrepTimeMinutes phút</span>
                            </div>

                            <div class="text-muted small text-truncate mb-3">
                                <i class="fa-solid fa-location-dot me-1 text-danger"></i>@(string.IsNullOrEmpty(r.Address) ? "Đang cập nhật địa chỉ" : r.Address)
                            </div>
                        </div>

                        <div class="pt-2 border-top d-flex align-items-center justify-content-between">
                            <span class="text-muted small">Đơn tối thiểu: <strong>@r.MinOrderAmount.ToString("N0")đ</strong></span>
                            <a asp-controller="Restaurant" asp-action="Details" asp-route-id="@r.Id" class="btn btn-brand btn-sm fw-bold px-3 py-2 rounded-3 shadow-xs">
                                Đặt món <i class="fa-solid fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        const searchInput = document.getElementById('favSearchInput');
        if (searchInput) {
            searchInput.addEventListener('input', function() {
                const keyword = this.value.trim().toLowerCase();
                document.querySelectorAll('.fav-card-item').forEach(card => {
                    const name = card.dataset.name || '';
                    const address = card.dataset.address || '';
                    if (name.includes(keyword) || address.includes(keyword)) {
                        card.style.display = '';
                    } else {
                        card.style.display = 'none';
                    }
                });
            });
        }
    </script>
}
