@model baitaplontmdtwebdatdoan.Models.Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.OrderCode;

    string GetStatusLabel(string status) => status switch
    {
        "pending" => "Chờ xác nhận",
        "confirmed" => "Đã xác nhận",
        "preparing" => "Đang chuẩn bị",
        "ready_for_pickup" => "Chờ lấy hàng",
        "picked_up" => "Tài xế đã lấy hàng",
        "delivering" => "Đang giao hàng",
        "completed" => "Giao thành công",
        "cancelled" => "Đã huỷ",
        _ => status
    };

    string GetPaymentLabel(string status) => status switch
    {
        "unpaid" => "Chưa thanh toán",
        "paid" => "Đã thanh toán",
        "refunded" => "Đã hoàn tiền",
        _ => status
    };

    string GetPaymentMethodName(string method) => method switch
    {
        "cod" => "Tiền mặt khi nhận hàng (COD)",
        "bank_transfer" => "Chuyển khoản Ngân hàng (VietQR)",
        "wallet" => "Ví điện tử Foodie Pay",
        "credit_card" => "Thẻ Quốc tế (Visa / Master)",
        "momo" => "Ví điện tử MoMo",
        "zalopay" => "Ví điện tử ZaloPay",
        _ => method.ToUpper()
    };

    int GetStepIndex(string status) => status switch
    {
        "pending" => 1,
        "confirmed" => 2,
        "preparing" => 3,
        "ready_for_pickup" => 4,
        "picked_up" => 4,
        "delivering" => 4,
        "completed" => 5,
        "cancelled" => -1,
        _ => 1
    };

    var currentStep = GetStepIndex(Model.OrderStatus);
    var receiverName = Model.DeliveryAddress?.ReceiverName ?? Model.User?.FullName ?? "Khách hàng";
    var receiverPhone = Model.DeliveryAddress?.ReceiverPhone ?? Model.User?.Phone ?? "Chưa cập nhật";
    var deliveryAddress = Model.DeliveryAddress?.AddressLine ?? "Địa chỉ giao tận nơi";
    var existingReview = ViewBag.ExistingReview as baitaplontmdtwebdatdoan.Models.Review;

    var restLat = (decimal)(ViewBag.RestaurantLat ?? 10.7769m);
    var restLng = (decimal)(ViewBag.RestaurantLng ?? 106.7009m);
    var delLat = (decimal)(ViewBag.DeliveryLat ?? 10.7850m);
    var delLng = (decimal)(ViewBag.DeliveryLng ?? 106.6950m);
}

<!-- Leaflet CSS for Map -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<!-- HEADER TIÊU ĐỀ & ĐIỀU HƯỚNG -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <a asp-controller="Order" asp-action="MyOrders" class="text-decoration-none text-muted small fw-semibold">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại đơn hàng của tôi
        </a>
        <div class="d-flex align-items-center gap-2 mt-1">
            <h4 class="fw-bold mb-0">Đơn hàng #@Model.OrderCode</h4>
            <span class="badge @(Model.OrderStatus == "completed" ? "bg-success" : Model.OrderStatus == "cancelled" ? "bg-danger" : "bg-warning text-dark") px-3 py-1 rounded-pill" id="headerStatusBadge">
                @GetStatusLabel(Model.OrderStatus)
            </span>
        </div>
        <div class="text-muted small mt-1">
            <i class="fa-regular fa-clock me-1"></i>Đặt lúc: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Restaurant" asp-action="Details" asp-route-id="@Model.RestaurantId" class="btn btn-outline-brand btn-sm fw-semibold rounded-3 px-3">
            <i class="fa-solid fa-store me-1"></i> Xem quán ăn
        </a>
        <button type="button" class="btn btn-light border btn-sm fw-semibold rounded-3 px-3" onclick="window.print()">
            <i class="fa-solid fa-print me-1"></i> In phiếu
        </button>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- 1. THANH TIẾN TRÌNH TRẠNG THÁI ĐƠN HÀNG (STEPPER) -->
@if (Model.OrderStatus != "cancelled")
{
    <div class="bg-white rounded-4 shadow-sm p-4 mb-4">
        <h6 class="fw-bold mb-4 text-muted text-uppercase small"><i class="fa-solid fa-timeline me-2 text-brand"></i>Tiến trình giao hàng theo thời gian thực</h6>
        
        <div class="order-stepper position-relative d-flex justify-content-between">
            <div class="stepper-progress-bar">
                <div class="stepper-progress-line" style="width: @((currentStep - 1) * 25)%;"></div>
            </div>

            <!-- Bước 1 -->
            <div class="step-item text-center @(currentStep >= 1 ? "step-active" : "")">
                <div class="step-icon-circle mx-auto mb-2 shadow-xs">
                    <i class="fa-solid fa-receipt"></i>
                </div>
                <div class="step-label fw-bold small">Chờ xác nhận</div>
                <div class="step-time text-muted" style="font-size:11px">Đã gửi quán</div>
            </div>

            <!-- Bước 2 -->
            <div class="step-item text-center @(currentStep >= 2 ? "step-active" : "")">
                <div class="step-icon-circle mx-auto mb-2 shadow-xs">
                    <i class="fa-solid fa-clipboard-check"></i>
                </div>
                <div class="step-label fw-bold small">Đã xác nhận</div>
                <div class="step-time text-muted" style="font-size:11px">Quán đã nhận</div>
            </div>

            <!-- Bước 3 -->
            <div class="step-item text-center @(currentStep >= 3 ? "step-active" : "")">
                <div class="step-icon-circle mx-auto mb-2 shadow-xs">
                    <i class="fa-solid fa-fire-burner"></i>
                </div>
                <div class="step-label fw-bold small">Đang chuẩn bị</div>
                <div class="step-time text-muted" style="font-size:11px">Đang nấu món</div>
            </div>

            <!-- Bước 4 -->
            <div class="step-item text-center @(currentStep >= 4 ? "step-active" : "")">
                <div class="step-icon-circle mx-auto mb-2 shadow-xs">
                    <i class="fa-solid fa-truck-fast"></i>
                </div>
                <div class="step-label fw-bold small">Đang giao hàng</div>
                <div class="step-time text-muted" style="font-size:11px">Shipper trên đường</div>
            </div>

            <!-- Bước 5 -->
            <div class="step-item text-center @(currentStep >= 5 ? "step-active" : "")">
                <div class="step-icon-circle mx-auto mb-2 shadow-xs">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <div class="step-label fw-bold small">Hoàn thành</div>
                <div class="step-time text-muted" style="font-size:11px">Đã nhận món</div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-danger rounded-4 p-4 mb-4 shadow-sm d-flex align-items-center gap-3">
        <i class="fa-solid fa-circle-xmark fs-1 text-danger"></i>
        <div>
            <h5 class="fw-bold mb-1">Đơn hàng này đã bị huỷ</h5>
            <p class="mb-0 text-muted small">Lý do huỷ: <strong>@(string.IsNullOrEmpty(Model.CancelReason) ? "Khách hàng yêu cầu huỷ" : Model.CancelReason)</strong></p>
        </div>
    </div>
}

<!-- ===== 2. BẢN ĐỒ REAL-TIME THEO DÕI ĐƠN HÀNG TRỰC TIẾP (LIVE TRACKING MAP) ===== -->
@if (Model.OrderStatus != "cancelled")
{
    <div class="bg-white rounded-4 shadow-sm p-4 mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
            <div>
                <h6 class="fw-bold mb-1 d-flex align-items-center gap-2">
                    <i class="fa-solid fa-map-location-dot text-brand fs-5"></i>
                    BẢN ĐỒ THEO DÕI TRỰC TIẾP
                    <span class="badge bg-danger rounded-pill px-2 py-1 live-radar-badge" style="font-size:10px">
                        <i class="fa-solid fa-satellite-dish me-1"></i>REAL-TIME
                    </span>
                </h6>
                <div class="text-muted small">Xem trực tiếp vị trí nhà hàng, shipper đang giao và điểm nhận hàng của bạn</div>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-brand btn-sm fw-bold rounded-pill px-3" id="btnSimulateDriver">
                    <i class="fa-solid fa-play me-1"></i>Mô phỏng tài xế di chuyển
                </button>
                <button type="button" class="btn btn-light border btn-sm rounded-pill px-3" id="btnCenterMap" title="Căn giữa bản đồ">
                    <i class="fa-solid fa-crosshairs me-1"></i>Toàn cảnh
                </button>
            </div>
        </div>

        <div class="position-relative rounded-4 overflow-hidden shadow-xs border" style="height: 380px;">
            <!-- Khung bản đồ Leaflet -->
            <div id="orderTrackingMap" style="width: 100%; height: 100%; z-index: 1;"></div>

            <!-- Bảng thông tin tài xế nổi (Floating Driver HUD Card) -->
            <div class="driver-hud-card position-absolute bg-white rounded-4 shadow-lg p-3 z-3 border" 
                 style="bottom: 16px; left: 16px; right: 16px; max-width: 420px;">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <div class="position-relative">
                            <img src="https://ui-avatars.com/api/?name=@(Model.Shipper?.FullName ?? "Shipper+Foodie")&background=14402E&color=fff" 
                                 class="rounded-circle shadow-xs" width="44" height="44" alt="Driver" />
                            <span class="position-absolute bottom-0 end-0 bg-success border border-white rounded-circle p-1"></span>
                        </div>
                        <div>
                            <div class="fw-bold text-dark small">@(Model.Shipper?.FullName ?? "Tài xế Nguyễn Văn Hùng")</div>
                            <div class="text-muted" style="font-size:11px">
                                <i class="fa-solid fa-motorcycle text-brand me-1"></i>Honda Wave Alpha &bull; <strong class="text-dark">59-T2 888.99</strong>
                            </div>
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="badge bg-warning-subtle text-dark border small fw-bold">
                            <i class="fa-solid fa-star text-warning me-1"></i>4.9
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center bg-light p-2 rounded-3 small">
                    <div>
                        <span class="text-muted" style="font-size:11px">Trạng thái:</span>
                        <div class="fw-bold text-brand" id="hudDriverStatus">
                            @(Model.OrderStatus == "delivering" ? "Đang trên đường giao đến bạn" : Model.OrderStatus == "completed" ? "Đã giao hàng thành công" : "Đang chuẩn bị lấy hàng")
                        </div>
                    </div>
                    <div class="text-end">
                        <span class="text-muted" style="font-size:11px">Ước tính:</span>
                        <div class="fw-bold text-dark" id="hudEta">~8 phút (<span id="hudDistance">1.8 km</span>)</div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-2 pt-1">
                    <a href="tel:0987654321" class="btn btn-outline-success btn-sm flex-fill fw-bold rounded-pill">
                        <i class="fa-solid fa-phone me-1"></i>Gọi tài xế
                    </a>
                    <button type="button" class="btn btn-outline-primary btn-sm flex-fill fw-bold rounded-pill" onclick="alert('Tính năng nhắn tin đang kết nối với tài xế!')">
                        <i class="fa-solid fa-comment-dots me-1"></i>Nhắn tin
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- 3. KHỐI CHUYỂN KHOẢN VIETQR (NẾU CHỌN CHUYỂN KHOẢN VÀ CHƯA THANH TOÁN) -->
@if (Model.PaymentMethod == "bank_transfer" && Model.PaymentStatus == "unpaid" && Model.OrderStatus != "cancelled")
{
    <div class="bg-white rounded-4 shadow-sm p-4 mb-4 border border-primary-subtle">
        <div class="row align-items-center g-4">
            <div class="col-md-4 text-center">
                @{
                    var bank = ViewBag.Bank as baitaplontmdtwebdatdoan.Models.BankSettings;
                    var qrUrl = ViewBag.QrUrl as string;
                }
                @if (!string.IsNullOrEmpty(qrUrl))
                {
                    <img src="@qrUrl" alt="Mã VietQR thanh toán đơn @Model.OrderCode" class="img-fluid rounded-3 shadow-sm border p-2 bg-white" style="max-width:230px" />
                    <div class="small text-muted mt-2"><i class="fa-solid fa-qrcode me-1"></i>Quét bằng app ngân hàng, số tiền và nội dung tự điền sẵn</div>
                }
                else
                {
                    <div class="alert alert-warning small mb-0">
                        <i class="fa-solid fa-triangle-exclamation me-1"></i>
                        Cửa hàng chưa cấu hình tài khoản nhận tiền nên chưa tạo được mã QR.
                    </div>
                }
            </div>
            <div class="col-md-8">
                <span class="badge bg-primary-subtle text-primary border border-primary px-3 py-1 rounded-pill fw-bold mb-2">
                    <i class="fa-solid fa-building-columns me-1"></i> Thông tin chuyển khoản thanh toán
                </span>
                <h5 class="fw-bold text-dark mb-3">Vui lòng chuyển khoản để hoàn tất đơn hàng</h5>
                
                <div class="bg-light p-3 rounded-3 mb-3 border">
                    <div class="row g-2 small">
                        <div class="col-sm-4 text-muted">Ngân hàng:</div>
                        <div class="col-sm-8 fw-bold text-dark">@(string.IsNullOrWhiteSpace(bank?.BankName) ? bank?.BankId : bank.BankName)</div>

                        <div class="col-sm-4 text-muted">Số tài khoản:</div>
                        <div class="col-sm-8 fw-bold text-primary font-monospace fs-6">@bank?.AccountNo</div>

                        <div class="col-sm-4 text-muted">Tên thụ hưởng:</div>
                        <div class="col-sm-8 fw-bold text-dark">@bank?.AccountName</div>

                        <div class="col-sm-4 text-muted">Số tiền:</div>
                        <div class="col-sm-8 fw-bold text-danger fs-5">@Model.TotalAmount.ToString("N0")đ</div>

                        <div class="col-sm-4 text-muted">Nội dung chuyển:</div>
                        <div class="col-sm-8 fw-bold text-dark font-monospace"><mark class="px-2 py-1 rounded">@Model.OrderCode</mark></div>
                    </div>
                </div>

                <form asp-controller="Order" asp-action="ConfirmPayment" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success fw-bold px-4 py-2 rounded-3 shadow-sm">
                        <i class="fa-solid fa-circle-check me-2"></i>Tôi đã chuyển khoản xong
                    </button>
                </form>
                <div class="text-muted small mt-2">
                    <i class="fa-solid fa-info-circle me-1"></i> Sau khi chuyển khoản, bạn bấm nút xác nhận trên để đơn hàng được nhà hàng tiếp nhận nhanh chóng nhé.
                </div>
            </div>
        </div>
    </div>
}

<div class="row g-4">
    <!-- CỘT TRÁI: DANH SÁCH MÓN ĂN & TÓM TẮT TIỀN -->
    <div class="col-lg-7">
        <!-- DANH SÁCH MÓN ĐÃ ĐẶT -->
        <div class="bg-white rounded-4 shadow-sm p-4 mb-4">
            <h6 class="fw-bold mb-3"><i class="fa-solid fa-basket-shopping text-brand me-2"></i>Món ăn trong đơn (@Model.OrderItems.Sum(i => i.Quantity))</h6>
            
            <div class="list-group list-group-flush mb-3">
                @foreach (var it in Model.OrderItems)
                {
                    <div class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-3">
                            <img src="@(string.IsNullOrEmpty(it.MenuItem?.ImageUrl) ? "https://placehold.co/100x100?text=Food" : it.MenuItem.ImageUrl)" 
                                 class="rounded-3 object-fit-cover shadow-sm" style="width:55px; height:55px" alt="@it.ItemName" 
                                 onerror="this.src='https://placehold.co/100x100?text=Food';" />
                            <div>
                                <div class="fw-bold text-dark">@it.ItemName</div>
                                <div class="text-muted small">@it.UnitPrice.ToString("N0")đ x @it.Quantity</div>
                            </div>
                        </div>
                        <span class="fw-bold text-dark fs-6">@it.LineTotal.ToString("N0")đ</span>
                    </div>
                }
            </div>

            <!-- BẢNG TỔNG TIỀN -->
            <div class="border-top pt-3">
                <div class="d-flex justify-content-between py-1 text-muted small">
                    <span>Tạm tính</span>
                    <span class="fw-semibold text-dark">@Model.Subtotal.ToString("N0")đ</span>
                </div>
                <div class="d-flex justify-content-between py-1 text-muted small">
                    <span>Phí vận chuyển</span>
                    <span class="fw-semibold text-dark">@Model.ShippingFee.ToString("N0")đ</span>
                </div>
                @if (Model.DiscountAmount > 0)
                {
                    <div class="d-flex justify-content-between py-1 text-success fw-bold small">
                        <span>Khuyến mãi Voucher</span>
                        <span>-@Model.DiscountAmount.ToString("N0")đ</span>
                    </div>
                }
                <div class="d-flex justify-content-between fw-bold fs-5 pt-3 border-top mt-2">
                    <span>Tổng cộng</span>
                    <span class="text-brand fs-4">@Model.TotalAmount.ToString("N0")đ</span>
                </div>
            </div>
        </div>

        <!-- LỊCH SỬ THAY ĐỔI TRẠNG THÁI -->
        @if (Model.OrderStatusHistories.Any())
        {
            <div class="bg-white rounded-4 shadow-sm p-4 mb-4">
                <h6 class="fw-bold mb-3"><i class="fa-solid fa-clock-rotate-left text-brand me-2"></i>Nhật ký cập nhật đơn hàng</h6>
                <div class="timeline-wrapper">
                    @foreach (var h in Model.OrderStatusHistories.OrderByDescending(x => x.ChangedAt))
                    {
                        <div class="d-flex gap-3 mb-3">
                            <div class="text-brand pt-1"><i class="fa-solid fa-circle-dot"></i></div>
                            <div>
                                <div class="fw-bold small text-dark">@h.Note</div>
                                <div class="text-muted" style="font-size:11px">@h.ChangedAt.ToString("dd/MM/yyyy HH:mm:ss") (Trạng thái: @GetStatusLabel(h.Status))</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- CỘT PHẢI: THÔNG TIN GIAO HÀNG & NHÀ HÀNG & ĐÁNH GIÁ & HUỶ ĐƠN -->
    <div class="col-lg-5">
        <!-- THÔNG TIN GIAO HÀNG -->
        <div class="bg-white rounded-4 shadow-sm p-4 mb-4">
            <h6 class="fw-bold mb-3"><i class="fa-solid fa-location-dot text-danger me-2"></i>Địa chỉ nhận hàng</h6>
            <div class="mb-2">
                <span class="fw-bold text-dark">@receiverName</span> 
                <span class="text-muted">(@receiverPhone)</span>
            </div>
            <div class="text-muted small mb-3">
                <i class="fa-solid fa-house-chimney me-1 text-secondary"></i>@deliveryAddress
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Note))
            {
                <div class="bg-light p-2 rounded-3 small text-muted border-start border-3 border-brand">
                    <span class="fw-bold text-dark">Ghi chú:</span> @Model.Note
                </div>
            }
        </div>

        <!-- THÔNG TIN NHÀ HÀNG -->
        <div class="bg-white rounded-4 shadow-sm p-4 mb-4">
            <h6 class="fw-bold mb-3"><i class="fa-solid fa-store text-brand me-2"></i>Nhà hàng chuẩn bị</h6>
            <div class="fw-bold text-dark fs-6 mb-1">@(Model.Restaurant?.Name ?? "Nhà hàng Foodie")</div>
            <div class="text-muted small mb-1">
                <i class="fa-solid fa-location-dot me-1 text-danger"></i>@(Model.Restaurant?.Address ?? "Địa chỉ quán")
            </div>
            @if (!string.IsNullOrEmpty(Model.Restaurant?.Phone))
            {
                <div class="text-muted small mb-2">
                    <i class="fa-solid fa-phone me-1 text-success"></i>@Model.Restaurant.Phone
                </div>
            }
            <a asp-controller="Restaurant" asp-action="Details" asp-route-id="@Model.RestaurantId" class="btn btn-outline-brand btn-sm w-100 fw-semibold rounded-3 mt-2">
                Xem Menu quán này
            </a>
        </div>

        <!-- THÔNG TIN THANH TOÁN & TRẠNG THÁI -->
        <div class="bg-white rounded-4 shadow-sm p-4 mb-4">
            <h6 class="fw-bold mb-3"><i class="fa-solid fa-credit-card text-brand me-2"></i>Thanh toán</h6>
            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                <span class="text-muted small">Hình thức:</span>
                <span class="fw-bold small text-dark">@GetPaymentMethodName(Model.PaymentMethod)</span>
            </div>
            <div class="d-flex justify-content-between align-items-center py-2">
                <span class="text-muted small">Trạng thái:</span>
                <span id="paymentBadge" class="badge @(Model.PaymentStatus == "paid" ? "bg-success" : Model.PaymentStatus == "refunded" ? "bg-info text-dark" : "bg-warning text-dark") px-3 py-2 rounded-pill small">
                    <i class="fa-solid @(Model.PaymentStatus == "paid" ? "fa-circle-check" : "fa-clock") me-1"></i>@GetPaymentLabel(Model.PaymentStatus)
                </span>
            </div>
        </div>

        <!-- ===== 4. KHỐI ĐÁNH GIÁ VÀ BÌNH LUẬN KHI MUA HÀNG XONG ===== -->
        @if (Model.OrderStatus == "completed")
        {
            <div class="bg-white rounded-4 shadow-sm p-4 mb-4 border border-warning-subtle">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="fa-solid fa-star text-warning me-2"></i>Đánh giá & Bình luận đơn hàng
                    </h6>
                    @if (existingReview != null)
                    {
                        <span class="badge bg-success-subtle text-success border border-success rounded-pill px-2 py-1 small">
                            Đã đánh giá
                        </span>
                    }
                </div>

                @if (existingReview != null)
                {
                    <div class="bg-light p-3 rounded-3 mb-3 border">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div class="text-warning fs-5">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= existingReview.Rating)
                                    {
                                        <i class="fa-solid fa-star"></i>
                                    }
                                    else
                                    {
                                        <i class="fa-regular fa-star text-muted"></i>
                                    }
                                }
                            </div>
                            <span class="text-muted" style="font-size:11px">@existingReview.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <p class="small text-dark mb-0">@(string.IsNullOrEmpty(existingReview.Comment) ? "Bạn đã chấm " + existingReview.Rating + " sao cho đơn hàng này." : existingReview.Comment)</p>

                        @if (!string.IsNullOrEmpty(existingReview.ReplyFromOwner))
                        {
                            <div class="bg-white p-2 rounded mt-2 border-start border-3 border-brand small">
                                <span class="fw-bold text-brand">Phản hồi của quán:</span> @existingReview.ReplyFromOwner
                            </div>
                        }
                    </div>

                    <button type="button" class="btn btn-outline-brand w-100 fw-bold py-2 rounded-3 shadow-xs" data-bs-toggle="modal" data-bs-target="#reviewModal">
                        <i class="fa-solid fa-pen-to-square me-1"></i> Chỉnh sửa đánh giá của bạn
                    </button>
                }
                else
                {
                    <p class="text-muted small mb-3">
                        Bạn thấy món ăn của quán thế nào? Hãy chia sẻ cảm nhận để quán phục vụ bạn tốt hơn nhé!
                    </p>
                    <button type="button" class="btn btn-brand w-100 fw-bold py-2 fs-6 rounded-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#reviewModal">
                        <i class="fa-solid fa-star me-2"></i> Viết đánh giá & Nhận xét
                    </button>
                }
            </div>
        }

        <!-- ===== 5. CÁC HÀNH ĐỘNG HUỶ ĐƠN / HOÀN TIỀN (CHẶN HỦY NẾU ĐÃ/ĐANG GIAO) ===== -->
        <div class="d-flex flex-column gap-2">
            @if (Model.OrderStatus == "pending" || Model.OrderStatus == "confirmed")
            {
                <button type="button" class="btn btn-outline-danger w-100 fw-bold py-2 rounded-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#cancelModal">
                    <i class="fa-solid fa-xmark me-1"></i> Huỷ đơn hàng
                </button>
            }
            else if (Model.OrderStatus == "preparing" || Model.OrderStatus == "ready_for_pickup" || Model.OrderStatus == "picked_up" || Model.OrderStatus == "delivering")
            {
                <!-- CẢNH BÁO KHÔNG ĐƯỢC HỦY KHI ĐANG GIAO HOẶC ĐANG CHẾ BIẾN -->
                <div class="card border-0 bg-warning-subtle text-dark rounded-4 p-3 shadow-xs">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-warning text-dark p-2 d-flex align-items-center justify-content-center flex-shrink-0" style="width:40px;height:40px">
                            <i class="fa-solid fa-lock fs-5"></i>
                        </div>
                        <div class="small">
                            <div class="fw-bold">Không thể huỷ đơn hàng lúc này</div>
                            <div class="text-muted">
                                Đơn hàng @(Model.OrderStatus == "delivering" || Model.OrderStatus == "picked_up" ? "đang trên đường giao hàng" : "đang được nhà hàng nấu món"). Quý khách vui lòng liên hệ nhà hàng nếu cần hỗ trợ khẩn cấp.
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (Model.OrderStatus == "completed" && Model.PaymentStatus != "refunded")
            {
                <button type="button" class="btn btn-outline-brand w-100 fw-bold py-2 rounded-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#refundModal">
                    <i class="fa-solid fa-rotate-left me-1"></i> Yêu cầu hoàn tiền
                </button>
            }

            @if (Model.PaymentStatus == "refunded")
            {
                <div class="alert alert-success mb-0 text-center fw-semibold rounded-3 shadow-sm">
                    <i class="fa-solid fa-circle-check me-1"></i> Đơn hàng đã được hoàn tiền vào Ví Foodie
                </div>
            }
        </div>
    </div>
</div>

<!-- ===== MODAL ĐÁNH GIÁ BÌNH LUẬN ĐƠN HÀNG ===== -->
<div class="modal fade" id="reviewModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom pb-3">
                <h5 class="modal-title fw-bold text-dark">
                    <i class="fa-solid fa-star text-warning me-2"></i>Đánh giá món ăn & Quán ăn
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form asp-controller="Order" asp-action="SubmitReview" method="post" id="reviewForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="orderId" value="@Model.Id" />
                    <input type="hidden" name="rating" id="reviewRatingInput" value="@(existingReview?.Rating ?? 5)" />

                    <!-- Quán ăn info -->
                    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                        <i class="fa-solid fa-store text-brand fs-5"></i>
                        <span class="fw-bold text-dark">@(Model.Restaurant?.Name ?? "Quán ăn")</span>
                    </div>

                    <!-- Chọn sao đánh giá (Interactive Star Rating) -->
                    <div class="text-center mb-3">
                        <label class="form-label small fw-semibold text-muted text-uppercase mb-2">Chất lượng món ăn</label>
                        <div class="rating-stars-container fs-2 d-flex justify-content-center gap-2 cursor-pointer" id="starRatingBox">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="fa-solid fa-star rating-star-item @(i <= (existingReview?.Rating ?? 5) ? "text-warning" : "text-muted")" data-val="@i"></i>
                            }
                        </div>
                        <div class="small fw-bold text-brand mt-1" id="starRatingLabel">
                            @(existingReview?.Rating == 5 ? "Tuyệt vời!" : existingReview?.Rating == 4 ? "Rất ngon" : existingReview?.Rating == 3 ? "Bình thường" : existingReview?.Rating == 2 ? "Chưa hài lòng" : "Kém")
                        </div>
                    </div>

                    <!-- Nhập nhận xét -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Nhận xét chi tiết của bạn:</label>
                        <textarea name="comment" class="form-control rounded-3" rows="3" 
                                  placeholder="Món ăn vừa miệng, nóng hổi, quán đóng gói cẩn thận...">@(existingReview?.Comment ?? "")</textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary flex-fill rounded-3" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-brand flex-fill fw-bold rounded-3">
                            <i class="fa-solid fa-paper-plane me-1"></i>Gửi đánh giá
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal xác nhận huỷ đơn -->
<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-body text-center p-4">
                <i class="fa-solid fa-triangle-exclamation text-danger fs-1 mb-3"></i>
                <h5 class="fw-bold">Huỷ đơn hàng?</h5>
                <p class="text-muted">Bạn có chắc chắn muốn huỷ đơn <strong>#@Model.OrderCode</strong>? Hành động này không thể hoàn tác.</p>

                <form asp-controller="Order" asp-action="Cancel" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3 text-start">
                        <label class="form-label small fw-semibold">Lý do huỷ đơn:</label>
                        <select name="reason" class="form-select rounded-3">
                            <option value="Tôi muốn đổi món / đổi địa chỉ">Tôi muốn đổi món / đổi địa chỉ</option>
                            <option value="Thời gian giao quá lâu">Thời gian giao quá lâu</option>
                            <option value="Tôi đặt nhầm đơn">Tôi đặt nhầm đơn</option>
                            <option value="Khác">Lý do khác</option>
                        </select>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary flex-fill rounded-3" data-bs-dismiss="modal">Không, giữ đơn</button>
                        <button type="submit" class="btn btn-danger flex-fill fw-bold rounded-3">Xác nhận huỷ</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal yêu cầu hoàn tiền -->
<div class="modal fade" id="refundModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-body p-4">
                <div class="text-center mb-3">
                    <i class="fa-solid fa-rotate-left text-brand fs-1 mb-2"></i>
                    <h5 class="fw-bold">Yêu cầu hoàn tiền</h5>
                    <p class="text-muted small">Số tiền <strong>@Model.TotalAmount.ToString("N0")đ</strong> sẽ được hoàn vào Ví Foodie của bạn.</p>
                </div>
                <form asp-controller="Order" asp-action="RequestRefund" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Lý do hoàn tiền <span class="text-danger">*</span></label>
                        <select name="reason" class="form-select rounded-3" required>
                            <option value="">-- Chọn lý do --</option>
                            <option value="Món ăn không đúng như mô tả">Món ăn không đúng như mô tả</option>
                            <option value="Món ăn bị hư hỏng, kém chất lượng">Món ăn bị hư hỏng, kém chất lượng</option>
                            <option value="Giao thiếu món">Giao thiếu món</option>
                            <option value="Giao sai món">Giao sai món</option>
                            <option value="Lý do khác">Lý do khác</option>
                        </select>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary flex-fill rounded-3" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-brand flex-fill fw-bold rounded-3">Gửi yêu cầu</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .order-stepper {
        padding: 10px 20px;
    }
    .stepper-progress-bar {
        position: absolute;
        top: 25px;
        left: 50px;
        right: 50px;
        height: 4px;
        background-color: #e9ecef;
        z-index: 1;
    }
    .stepper-progress-line {
        height: 100%;
        background-color: var(--brand-strong);
        transition: width 0.4s ease;
    }
    .step-item {
        position: relative;
        z-index: 2;
        width: 100px;
    }
    .step-icon-circle {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: #f8f9fa;
        color: #adb5bd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        border: 2px solid #e9ecef;
        transition: all 0.3s ease;
    }
    .step-item.step-active .step-icon-circle {
        background: var(--brand-strong);
        color: #fff;
        border-color: var(--brand-strong);
    }
    .step-item.step-active .step-label {
        color: var(--brand-strong) !important;
    }

    /* Radar badge animation */
    .live-radar-badge {
        animation: radarPulse 1.8s infinite ease-in-out;
    }
    @@keyframes radarPulse {
        0% { opacity: 1; }
        50% { opacity: 0.55; }
        100% { opacity: 1; }
    }

    .rating-star-item {
        transition: transform 0.15s ease;
    }
    .rating-star-item:hover {
        transform: scale(1.2);
    }
</style>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        // SignalR Real-time Connection
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/orderHub")
            .withAutomaticReconnect()
            .build();

        connection.on("StatusUpdated", function (status, label) {
            location.reload();
        });

        connection.on("PaymentUpdated", function (status) {
            location.reload();
        });

        connection.start().then(function () {
            connection.invoke("JoinOrderGroup", "@Model.Id");
        });

        // Xử lý chọn sao đánh giá
        const ratingInput = document.getElementById('reviewRatingInput');
        const ratingLabel = document.getElementById('starRatingLabel');
        const starItems = document.querySelectorAll('.rating-star-item');
        const starLabels = {
            1: 'Rất tệ',
            2: 'Chưa hài lòng',
            3: 'Bình thường',
            4: 'Rất ngon!',
            5: 'Tuyệt vời, 5 sao!'
        };

        starItems.forEach(star => {
            star.addEventListener('click', function () {
                const val = parseInt(this.dataset.val);
                ratingInput.value = val;
                ratingLabel.textContent = starLabels[val] || '';

                starItems.forEach(s => {
                    const sVal = parseInt(s.dataset.val);
                    if (sVal <= val) {
                        s.classList.remove('text-muted');
                        s.classList.add('text-warning');
                    } else {
                        s.classList.remove('text-warning');
                        s.classList.add('text-muted');
                    }
                });
            });
        });

        // ===== KHỞI TẠO BẢN ĐỒ REAL-TIME LEAFLET =====
        const mapContainer = document.getElementById('orderTrackingMap');
        if (mapContainer) {
            const restCoord = [@restLat, @restLng];
            const delivCoord = [@delLat, @delLng];

            // Tọa độ khởi tạo của tài xế (nằm giữa nhà hàng và khách hàng)
            let driverCoord = [
                restCoord[0] + (delivCoord[0] - restCoord[0]) * 0.45,
                restCoord[1] + (delivCoord[1] - restCoord[1]) * 0.45
            ];

            const map = L.map('orderTrackingMap', {
                zoomControl: true,
                attributionControl: false
            }).setView(driverCoord, 14);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19
            }).addTo(map);

            // Custom Marker Icons
            const restaurantIcon = L.divIcon({
                className: 'custom-map-marker',
                html: `<div style="background:#A63C04; color:#fff; width:38px; height:38px; border-radius:50%; display:flex; align-items:center; justify-content:center; box-shadow:0 4px 10px rgba(0,0,0,0.3); border:2px solid #fff;"><i class="fa-solid fa-store fs-6"></i></div>`,
                iconSize: [38, 38],
                iconAnchor: [19, 19]
            });

            const deliveryIcon = L.divIcon({
                className: 'custom-map-marker',
                html: `<div style="background:#28A745; color:#fff; width:38px; height:38px; border-radius:50%; display:flex; align-items:center; justify-content:center; box-shadow:0 4px 10px rgba(0,0,0,0.3); border:2px solid #fff;"><i class="fa-solid fa-house-chimney fs-6"></i></div>`,
                iconSize: [38, 38],
                iconAnchor: [19, 19]
            });

            const driverIcon = L.divIcon({
                className: 'custom-map-marker driver-marker-animated',
                html: `<div style="background:#C94B07; color:#fff; width:44px; height:44px; border-radius:50%; display:flex; align-items:center; justify-content:center; box-shadow:0 0 0 8px rgba(255,122,0,0.25); border:3px solid #fff;"><i class="fa-solid fa-motorcycle fs-5"></i></div>`,
                iconSize: [44, 44],
                iconAnchor: [22, 22]
            });

            // Markers
            const restMarker = L.marker(restCoord, { icon: restaurantIcon }).addTo(map)
                .bindPopup("<b>@(Model.Restaurant?.Name ?? "Nhà hàng Foodie")</b><br/><span style='font-size:12px'>@(Model.Restaurant?.Address ?? "")</span>");

            const delivMarker = L.marker(delivCoord, { icon: deliveryIcon }).addTo(map)
                .bindPopup("<b>Giao đến: @receiverName</b><br/><span style='font-size:12px'>@deliveryAddress</span>");

            const driverMarker = L.marker(driverCoord, { icon: driverIcon }).addTo(map)
                .bindPopup("<b>Tài xế đang di chuyển</b><br/><span style='font-size:12px'>Đang giao hàng đến bạn</span>");

            // Polyline đường giao hàng
            const routeLine = L.polyline([restCoord, driverCoord, delivCoord], {
                color: '#C94B07',
                weight: 5,
                opacity: 0.85,
                dashArray: '8, 8',
                lineCap: 'round'
            }).addTo(map);

            // Căn góc nhìn toàn cảnh
            const groupBounds = L.latLngBounds([restCoord, delivCoord, driverCoord]);
            map.fitBounds(groupBounds, { padding: [50, 50] });

            document.getElementById('btnCenterMap')?.addEventListener('click', () => {
                map.fitBounds(groupBounds, { padding: [50, 50] });
            });

            // Lắng nghe cập nhật vị trí tài xế qua SignalR
            connection.on("DriverLocationUpdated", function (lat, lng, note) {
                driverCoord = [lat, lng];
                driverMarker.setLatLng(driverCoord);
                routeLine.setLatLngs([restCoord, driverCoord, delivCoord]);
                if (note) {
                    document.getElementById('hudDriverStatus').innerText = note;
                }
            });

            // Mô phỏng tài xế di chuyển mượt mà (Simulation Animation)
            let simInterval = null;
            let simProgress = 0.45;
            const btnSim = document.getElementById('btnSimulateDriver');

            function startSimulation() {
                if (simInterval) {
                    clearInterval(simInterval);
                    simInterval = null;
                    btnSim.innerHTML = '<i class="fa-solid fa-play me-1"></i>Mô phỏng tài xế di chuyển';
                    return;
                }

                btnSim.innerHTML = '<i class="fa-solid fa-pause me-1"></i>Dừng mô phỏng';
                simInterval = setInterval(() => {
                    simProgress += 0.02;
                    if (simProgress >= 1.0) {
                        simProgress = 1.0;
                        clearInterval(simInterval);
                        simInterval = null;
                        btnSim.innerHTML = '<i class="fa-solid fa-rotate-left me-1"></i>Mô phỏng lại';
                        document.getElementById('hudDriverStatus').innerText = 'Tài xế đã đến điểm giao hàng!';
                        document.getElementById('hudEta').innerText = '0 phút (Đã đến nơi)';
                        driverMarker.bindPopup("<b>Tài xế đã đến!</b><br/>Vui lòng chuẩn bị nhận món nhé.").openPopup();
                    } else {
                        const curLat = restCoord[0] + (delivCoord[0] - restCoord[0]) * simProgress;
                        const curLng = restCoord[1] + (delivCoord[1] - restCoord[1]) * simProgress;
                        driverMarker.setLatLng([curLat, curLng]);
                        routeLine.setLatLngs([restCoord, [curLat, curLng], delivCoord]);

                        const remDist = Math.max(0.1, (1.8 * (1 - simProgress))).toFixed(1);
                        const remMin = Math.max(1, Math.round(8 * (1 - simProgress)));
                        document.getElementById('hudDistance').innerText = remDist + ' km';
                        document.getElementById('hudEta').innerText = `~${remMin} phút (${remDist} km)`;
                    }
                }, 800);
            }

            btnSim?.addEventListener('click', startSimulation);

            // Tự động mô phỏng nếu đơn hàng đang ở trạng thái delivering
            if ("@Model.OrderStatus" === "delivering") {
                setTimeout(startSimulation, 1500);
            }
        }
    </script>
}