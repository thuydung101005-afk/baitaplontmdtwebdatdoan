@model baitaplontmdtwebdatdoan.Models.HomeIndexViewModel
@{
    ViewData["Title"] = "Trang chủ";

    string GetCategoryIcon(string name)
    {
        var lower = name.ToLower();
        if (lower.Contains("cơm")) return "fa-bowl-rice";
        if (lower.Contains("trà sữa") || lower.Contains("nước") || lower.Contains("uống") || lower.Contains("cà phê")) return "fa-mug-hot";
        if (lower.Contains("bún") || lower.Contains("phở") || lower.Contains("mì")) return "fa-bowl-food";
        if (lower.Contains("bánh mì") || lower.Contains("bánh")) return "fa-bread-slice";
        if (lower.Contains("gà")) return "fa-drumstick-bite";
        if (lower.Contains("pizza") || lower.Contains("burger")) return "fa-pizza-slice";
        if (lower.Contains("tráng miệng") || lower.Contains("chè") || lower.Contains("kem")) return "fa-ice-cream";
        return "fa-utensils";
    }
}

<!-- BANNER -->
<a asp-controller="Menu" asp-action="Index" class="fd-hero">
    <img src="/images/banner/banner-1.png" alt="Foodie - Đặt món ngon giao tận nơi" />
</a>

<!-- DANH MỤC -->
@if (Model.Categories.Any())
{
    <nav class="fd-cats" aria-label="Danh mục món ăn">
        <a asp-controller="Menu" asp-action="Index" class="fd-cat is-all">
            <div class="fd-cat-icon"><i class="fa-solid fa-border-all"></i></div>
            <div class="fd-cat-label">Tất cả</div>
        </a>
        @foreach (var cat in Model.Categories)
        {
            <a asp-controller="Menu" asp-action="Index" asp-route-category="@cat" class="fd-cat">
                <div class="fd-cat-icon"><i class="fa-solid @GetCategoryIcon(cat)"></i></div>
                <div class="fd-cat-label" title="@cat">@cat</div>
            </a>
        }
    </nav>
}

<!-- MÓN ĂN NỔI BẬT -->
<div class="fd-section-head">
    <h2>Món ăn nổi bật</h2>
    <a asp-controller="Menu" asp-action="Index" class="fd-more">Xem tất cả <i class="fa-solid fa-chevron-right ms-1 small"></i></a>
</div>
<div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-3 row-cols-xl-4 row-cols-xxl-5 g-3 mb-5">
    @foreach (var item in Model.FeaturedItems)
    {
        <div class="col">
            @await Html.PartialAsync("_MenuItemCard", item)
        </div>
    }
</div>

<!-- NHÀ HÀNG NỔI BẬT -->
<div class="fd-section-head">
    <h2>Nhà hàng nổi bật</h2>
    <a asp-controller="Restaurant" asp-action="Index" class="fd-more">Xem tất cả <i class="fa-solid fa-chevron-right ms-1 small"></i></a>
</div>
<div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-3 row-cols-xl-4 row-cols-xxl-5 g-3 mb-5">
    @foreach (var r in Model.FeaturedRestaurants)
    {
        <div class="col">
            <div class="card fd-card h-100">
                <button type="button" class="fd-fav toggle-fav-btn" data-restaurant-id="@r.Id" title="Thêm vào yêu thích" aria-label="Thêm vào yêu thích">
                    <i class="fa-regular fa-heart text-secondary"></i>
                </button>
                <a asp-controller="Restaurant" asp-action="Details" asp-route-id="@r.Id" class="text-decoration-none text-dark d-flex flex-column h-100">
                    <img src="@(string.IsNullOrEmpty(r.CoverImageUrl) ? "https://placehold.co/300x200?text=Restaurant" : r.CoverImageUrl)"
                         class="fd-card-img" alt="@r.Name"
                         onerror="this.src='https://placehold.co/300x200?text=Restaurant';" />
                    <div class="p-3">
                        <h3 class="h6 text-truncate fw-bold mb-1">@r.Name</h3>
                        <div class="fd-rest-meta">
                            <span><i class="fa-solid fa-star text-warning"></i> @(r.AvgRating > 0 ? r.AvgRating.ToString("0.0") : "5.0")</span>
                            <span class="dot"></span>
                            <span>@r.PrepTimeMinutes phút</span>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    }
</div>

<!-- ===== ƯU ĐÃI: HỘP THOẠI + NÚT NỔI ===== -->

<!-- 1. Hộp thoại ưu đãi -->
<div class="modal fade fd-promo" id="promoFloatingModal" tabindex="-1" aria-labelledby="promoFloatingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content overflow-hidden position-relative">
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>

            <div class="fd-promo-head">
                <h3 id="promoFloatingModalLabel">Giảm đến 50K và freeship</h3>
                <p>Lưu mã bên dưới, dùng khi thanh toán.</p>
            </div>

            <div class="modal-body p-4">
                <div class="d-flex flex-column gap-3 mb-4">
                    <div class="fd-ticket">
                        <div class="d-flex align-items-center gap-3">
                            <div class="fd-ticket-icon bg-danger-subtle text-danger"><i class="fa-solid fa-percent"></i></div>
                            <div>
                                <div class="fw-bold">Giảm 50.000đ đơn từ 100K</div>
                                <span class="fd-code">FOODIE50</span>
                            </div>
                        </div>
                        <button type="button" class="btn btn-outline-brand btn-sm rounded-pill px-3 copy-voucher-code" data-code="FOODIE50">Lấy mã</button>
                    </div>

                    <div class="fd-ticket">
                        <div class="d-flex align-items-center gap-3">
                            <div class="fd-ticket-icon bg-success-subtle text-success"><i class="fa-solid fa-truck-fast"></i></div>
                            <div>
                                <div class="fw-bold">Freeship 15.000đ toàn sàn</div>
                                <span class="fd-code">FREESHIP</span>
                            </div>
                        </div>
                        <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-3 copy-voucher-code" data-code="FREESHIP">Lấy mã</button>
                    </div>
                </div>

                <a asp-controller="Menu" asp-action="Index" class="btn btn-brand w-100 fw-bold py-2">
                    <i class="fa-solid fa-utensils me-2"></i>Xem thực đơn và đặt ngay
                </a>

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" id="dontShowPromoToday">
                        <label class="form-check-label text-muted small" for="dontShowPromoToday">Không hiện lại hôm nay</label>
                    </div>
                    <button type="button" class="btn btn-link text-muted small p-0" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 2. Nút ưu đãi nổi ở góc màn hình -->
<div id="floatingPromoWidget" class="fd-fab">
    <button type="button" class="btn" data-bs-toggle="modal" data-bs-target="#promoFloatingModal" title="Xem ưu đãi hôm nay">
        <span class="fd-fab-icon"><i class="fa-solid fa-gift"></i></span>
        <span class="fd-fab-text">
            <span class="fd-fab-title d-block">Ưu đãi hôm nay</span>
            <span class="fd-fab-sub d-block">Giảm đến 50K</span>
        </span>
    </button>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const promoModalEl = document.getElementById('promoFloatingModal');
            if (!promoModalEl) return;

            const promoModal = new bootstrap.Modal(promoModalEl);
            const dontShowKey = 'foodie_hide_promo_banner_date';
            const savedDate = localStorage.getItem(dontShowKey);
            const todayStr = new Date().toDateString();

            // Nếu người dùng chưa chọn ẩn hôm nay thì tự động hiện sau 800ms
            if (savedDate !== todayStr) {
                setTimeout(function () {
                    promoModal.show();
                }, 800);
            }

            // Xử lý lưu tuỳ chọn "Không hiện lại hôm nay"
            const checkbox = document.getElementById('dontShowPromoToday');
            if (checkbox) {
                checkbox.addEventListener('change', function () {
                    if (this.checked) {
                        localStorage.setItem(dontShowKey, todayStr);
                    } else {
                        localStorage.removeItem(dontShowKey);
                    }
                });
            }

            // Xử lý nút sao chép mã voucher
            document.querySelectorAll('.copy-voucher-code').forEach(btn => {
                btn.addEventListener('click', function () {
                    const code = this.dataset.code;
                    if (!code) return;
                    navigator.clipboard.writeText(code).then(() => {
                        const originalText = this.innerHTML;
                        this.innerHTML = '<i class="fa-solid fa-check text-success me-1"></i>Đã lưu';
                        this.classList.remove('btn-outline-brand', 'btn-outline-success');
                        this.classList.add('btn-success', 'text-white');
                        setTimeout(() => {
                            this.innerHTML = originalText;
                            this.classList.remove('btn-success', 'text-white');
                            this.classList.add('btn-outline-brand');
                        }, 2000);
                        showGlobalToast('Đã sao chép mã ' + code + ' vào bộ nhớ tạm!');
                    });
                });
            });
        });
    </script>
}