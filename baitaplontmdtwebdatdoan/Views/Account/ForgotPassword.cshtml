@model baitaplontmdtwebdatdoan.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = "_AuthLayout";
}

<div class="auth-head">
    <h1>Quên mật khẩu?</h1>
    <p>Nhập email đã đăng ký. Chúng tôi sẽ gửi mã xác nhận 6 số để bạn đặt lại mật khẩu.</p>
</div>

<form asp-controller="Account" asp-action="ForgotPassword" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger auth-summary"></div>

    <div class="auth-field">
        <label asp-for="Email">Email</label>
        <div class="auth-input">
            <i class="fa-regular fa-envelope"></i>
            <input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="email" autofocus />
        </div>
        <span asp-validation-for="Email" class="auth-error"></span>
    </div>

    <button type="submit" class="btn btn-brand auth-submit">Gửi mã xác nhận</button>
</form>

<p class="auth-alt">
    <a asp-controller="Account" asp-action="ResetPassword">Tôi đã có mã xác nhận</a>
</p>
<a asp-controller="Account" asp-action="Login" class="auth-back"><i class="fa-solid fa-arrow-left me-1"></i>Quay lại đăng nhập</a>
