@model baitaplontmdtwebdatdoan.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quên mật khẩu - Foodie</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .validation-summary-valid { display: none; }
        .auth-page { min-height: 100vh; background: linear-gradient(135deg, #FFF3E6 0%, #FFFFFF 55%, #FFE8D1 100%); }
        .auth-card { width: 100%; max-width: 430px; border: 0; border-radius: 20px; }
        .auth-logo { width: 64px; height: 64px; border-radius: 18px; background: #FF7A00; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 28px; margin: 0 auto; box-shadow: 0 8px 20px rgba(255,122,0,.35); }
        .auth-card .input-group-text { background: #f8f9fa; border-right: 0; color: #6c757d; }
        .auth-card .form-control { border-left: 0; }
        .auth-card .form-control:focus { box-shadow: none; border-color: #FF7A00; }
        .auth-card .input-group:focus-within .input-group-text { border-color: #FF7A00; color: #FF7A00; }
    </style>
</head>
<body>
    <div class="auth-page d-flex align-items-center justify-content-center p-3">
        <div class="card auth-card shadow p-4 p-sm-5">
            <div class="text-center mb-4">
                <div class="auth-logo"><i class="fa-solid fa-key"></i></div>
                <h4 class="fw-bold text-brand mt-3 mb-1">Quên mật khẩu?</h4>
                <div class="text-muted small">Nhập email đã đăng ký, chúng tôi sẽ gửi mã xác nhận 6 số để bạn đặt lại mật khẩu</div>
            </div>

            <form asp-controller="Account" asp-action="ForgotPassword" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label small fw-semibold">Email</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-regular fa-envelope"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="email" autofocus />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-brand w-100 fw-bold py-2 rounded-3">
                    <i class="fa-solid fa-paper-plane me-1"></i> Gửi mã xác nhận
                </button>
            </form>

            <div class="text-center mt-4 small">
                <a asp-controller="Account" asp-action="ResetPassword" class="text-brand fw-semibold text-decoration-none">Tôi đã có mã xác nhận</a>
            </div>
            <div class="text-center mt-2 small">
                <a asp-controller="Account" asp-action="Login" class="text-muted text-decoration-none"><i class="fa-solid fa-arrow-left me-1"></i>Quay lại đăng nhập</a>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
