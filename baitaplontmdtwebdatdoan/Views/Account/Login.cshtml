@model baitaplontmdtwebdatdoan.Models.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Đăng nhập - Foodie</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="bg-light">
    <div class="d-flex align-items-center justify-content-center" style="min-height:100vh">
        <div class="card shadow-sm p-4" style="width:100%;max-width:420px;border-radius:16px">
            <div class="text-center mb-3">
                <i class="fa-solid fa-utensils fs-2 text-brand"></i>
                <h4 class="fw-bold text-brand mt-2">Đăng nhập Foodie</h4>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success small">@TempData["SuccessMessage"]</div>
            }

            <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label small fw-semibold"></label>
                    <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label small fw-semibold"></label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label small"></label>
                </div>

                <button type="submit" class="btn btn-brand w-100 fw-bold py-2">Đăng nhập</button>
            </form>

            <div class="text-center mt-3 small">
                Chưa có tài khoản? <a asp-controller="Account" asp-action="Register" asp-route-returnUrl="@ViewBag.ReturnUrl" class="text-brand fw-semibold">Đăng ký ngay</a>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>