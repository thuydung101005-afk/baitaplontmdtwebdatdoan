@model baitaplontmdtwebdatdoan.Models.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_AuthLayout";
}

<div class="auth-head">
    <h1>Đăng nhập</h1>
    <p>Chào mừng bạn quay lại. Chọn món và theo dõi đơn hàng của bạn.</p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success"><i class="fa-solid fa-circle-check me-1"></i>@TempData["SuccessMessage"]</div>
}

<form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger auth-summary"></div>

    <div class="auth-field">
        <label asp-for="Email">Email</label>
        <div class="auth-input">
            <i class="fa-regular fa-envelope"></i>
            <input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="email" autofocus />
        </div>
        <span asp-validation-for="Email" class="auth-error"></span>
    </div>

    <div class="auth-field">
        <div class="auth-label-row">
            <label asp-for="Password"></label>
            <a asp-controller="Account" asp-action="ForgotPassword" tabindex="-1">Quên mật khẩu?</a>
        </div>
        <div class="auth-input">
            <i class="fa-solid fa-lock"></i>
            <input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu" autocomplete="current-password" />
            <button type="button" class="toggle-pass" tabindex="-1" aria-label="Hiện mật khẩu"><i class="fa-regular fa-eye"></i></button>
        </div>
        <span asp-validation-for="Password" class="auth-error"></span>
    </div>

    <div class="form-check mb-4">
        <input asp-for="RememberMe" class="form-check-input" />
        <label asp-for="RememberMe" class="form-check-label small"></label>
    </div>

    <button type="submit" class="btn btn-brand auth-submit">Đăng nhập</button>
</form>

<p class="auth-alt">
    Chưa có tài khoản?
    <a asp-controller="Account" asp-action="Register" asp-route-returnUrl="@ViewBag.ReturnUrl">Đăng ký</a>
</p>
<a href="/" class="auth-back"><i class="fa-solid fa-arrow-left me-1"></i>Về trang chủ</a>
