@model baitaplontmdtwebdatdoan.Models.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - Foodie</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .validation-summary-valid { display: none; }
        .auth-page { min-height: 100vh; background: linear-gradient(135deg, #FFF3E6 0%, #FFFFFF 55%, #FFE8D1 100%); }
        .auth-card { width: 100%; max-width: 430px; border: 0; border-radius: 20px; }
        .auth-logo { width: 64px; height: 64px; border-radius: 18px; background: #FF7A00; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 28px; margin: 0 auto; box-shadow: 0 8px 20px rgba(255,122,0,.35); }
        .auth-card .input-group-text { background: #f8f9fa; border-right: 0; color: #6c757d; }
        .auth-card .form-control { border-left: 0; }
        .auth-card .form-control:focus { box-shadow: none; border-color: #FF7A00; }
        .auth-card .input-group:focus-within .input-group-text { border-color: #FF7A00; color: #FF7A00; }
        .auth-card .toggle-pass { border-left: 0; background: #f8f9fa; border-color: #dee2e6; color: #6c757d; }
    </style>
</head>
<body>
    <div class="auth-page d-flex align-items-center justify-content-center p-3">
        <div class="card auth-card shadow p-4 p-sm-5">
            <div class="text-center mb-4">
                <div class="auth-logo"><i class="fa-solid fa-utensils"></i></div>
                <h4 class="fw-bold text-brand mt-3 mb-1">Chào mừng trở lại!</h4>
                <div class="text-muted small">Đăng nhập để đặt món ăn yêu thích của bạn</div>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success small py-2"><i class="fa-solid fa-circle-check me-1"></i>@TempData["SuccessMessage"]</div>
            }

            <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label small fw-semibold">Email</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-regular fa-envelope"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="email" autofocus />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <label asp-for="Password" class="form-label small fw-semibold"></label>
                        <a asp-controller="Account" asp-action="ForgotPassword" class="small text-brand text-decoration-none mb-2" tabindex="-1">Quên mật khẩu?</a>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
                        <input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu" autocomplete="current-password" />
                        <button type="button" class="btn toggle-pass" tabindex="-1" title="Hiện/ẩn mật khẩu"><i class="fa-regular fa-eye"></i></button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label small"></label>
                </div>

                <button type="submit" class="btn btn-brand w-100 fw-bold py-2 rounded-3">
                    <i class="fa-solid fa-right-to-bracket me-1"></i> Đăng nhập
                </button>
            </form>

            <div class="text-center mt-4 small">
                Chưa có tài khoản?
                <a asp-controller="Account" asp-action="Register" asp-route-returnUrl="@ViewBag.ReturnUrl" class="text-brand fw-semibold text-decoration-none">Đăng ký ngay</a>
            </div>
            <div class="text-center mt-2 small">
                <a href="/" class="text-muted text-decoration-none"><i class="fa-solid fa-arrow-left me-1"></i>Về trang chủ</a>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        document.querySelectorAll('.toggle-pass').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = this.parentElement.querySelector('input');
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                this.querySelector('i').className = show ? 'fa-regular fa-eye-slash' : 'fa-regular fa-eye';
            });
        });
    </script>
</body>
</html>
