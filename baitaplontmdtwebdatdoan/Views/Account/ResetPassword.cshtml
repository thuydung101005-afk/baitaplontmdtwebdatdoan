@model baitaplontmdtwebdatdoan.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    Layout = "_AuthLayout";
}

<div class="auth-head">
    <h1>Đặt lại mật khẩu</h1>
    <p>Nhập mã 6 số đã gửi tới email và chọn mật khẩu mới. Mã có hiệu lực 10 phút.</p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success"><i class="fa-solid fa-circle-check me-1"></i>@TempData["SuccessMessage"]</div>
}
@if (ViewBag.DevHint != null)
{
    <div class="alert alert-warning"><i class="fa-solid fa-triangle-exclamation me-1"></i>@ViewBag.DevHint</div>
}

<form asp-controller="Account" asp-action="ResetPassword" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger auth-summary"></div>

    <div class="auth-field">
        <label asp-for="Email">Email</label>
        <div class="auth-input">
            <i class="fa-regular fa-envelope"></i>
            <input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="email" />
        </div>
        <span asp-validation-for="Email" class="auth-error"></span>
    </div>

    <div class="auth-field">
        <label asp-for="Code"></label>
        <div class="auth-input">
            <i class="fa-solid fa-hashtag"></i>
            <input asp-for="Code" class="form-control code-input" placeholder="000000" maxlength="6" inputmode="numeric" autocomplete="one-time-code" autofocus />
        </div>
        <span asp-validation-for="Code" class="auth-error"></span>
    </div>

    <div class="auth-field">
        <label asp-for="NewPassword"></label>
        <div class="auth-input">
            <i class="fa-solid fa-lock"></i>
            <input asp-for="NewPassword" class="form-control" placeholder="Tối thiểu 6 ký tự" autocomplete="new-password" />
            <button type="button" class="toggle-pass" tabindex="-1" aria-label="Hiện mật khẩu"><i class="fa-regular fa-eye"></i></button>
        </div>
        <span asp-validation-for="NewPassword" class="auth-error"></span>
    </div>

    <div class="auth-field">
        <label asp-for="ConfirmPassword"></label>
        <div class="auth-input">
            <i class="fa-solid fa-lock"></i>
            <input asp-for="ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" />
            <button type="button" class="toggle-pass" tabindex="-1" aria-label="Hiện mật khẩu"><i class="fa-regular fa-eye"></i></button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="auth-error"></span>
    </div>

    <button type="submit" class="btn btn-brand auth-submit">Đặt lại mật khẩu</button>
</form>

<p class="auth-alt">
    Chưa nhận được mã?
    <a asp-controller="Account" asp-action="ForgotPassword">Gửi lại mã</a>
</p>
<a asp-controller="Account" asp-action="Login" class="auth-back"><i class="fa-solid fa-arrow-left me-1"></i>Quay lại đăng nhập</a>
