@model baitaplontmdtwebdatdoan.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đặt lại mật khẩu - Foodie</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .validation-summary-valid { display: none; }
        .auth-page { min-height: 100vh; background: linear-gradient(135deg, #FFF3E6 0%, #FFFFFF 55%, #FFE8D1 100%); }
        .auth-card { width: 100%; max-width: 440px; border: 0; border-radius: 20px; }
        .auth-logo { width: 64px; height: 64px; border-radius: 18px; background: #FF7A00; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 28px; margin: 0 auto; box-shadow: 0 8px 20px rgba(255,122,0,.35); }
        .auth-card .input-group-text { background: #f8f9fa; border-right: 0; color: #6c757d; }
        .auth-card .form-control { border-left: 0; }
        .auth-card .form-control:focus { box-shadow: none; border-color: #FF7A00; }
        .auth-card .input-group:focus-within .input-group-text { border-color: #FF7A00; color: #FF7A00; }
        .auth-card .toggle-pass { border-left: 0; background: #f8f9fa; border-color: #dee2e6; color: #6c757d; }
        .code-input { letter-spacing: 8px; font-size: 22px; font-weight: 700; text-align: center; }
    </style>
</head>
<body>
    <div class="auth-page d-flex align-items-center justify-content-center p-3">
        <div class="card auth-card shadow p-4 p-sm-5 my-3">
            <div class="text-center mb-4">
                <div class="auth-logo"><i class="fa-solid fa-shield-halved"></i></div>
                <h4 class="fw-bold text-brand mt-3 mb-1">Đặt lại mật khẩu</h4>
                <div class="text-muted small">Nhập mã 6 số đã gửi tới email và chọn mật khẩu mới. Mã có hiệu lực 10 phút.</div>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success small py-2"><i class="fa-solid fa-circle-check me-1"></i>@TempData["SuccessMessage"]</div>
            }
            @if (ViewBag.DevHint != null)
            {
                <div class="alert alert-warning small py-2"><i class="fa-solid fa-triangle-exclamation me-1"></i>@ViewBag.DevHint</div>
            }

            <form asp-controller="Account" asp-action="ResetPassword" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label small fw-semibold">Email</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-regular fa-envelope"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Code" class="form-label small fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-hashtag"></i></span>
                        <input asp-for="Code" class="form-control code-input" placeholder="000000" maxlength="6" inputmode="numeric" autocomplete="one-time-code" autofocus />
                    </div>
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label small fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
                        <input asp-for="NewPassword" class="form-control" placeholder="Tối thiểu 6 ký tự" autocomplete="new-password" />
                        <button type="button" class="btn toggle-pass" tabindex="-1" title="Hiện/ẩn mật khẩu"><i class="fa-regular fa-eye"></i></button>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label small fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" />
                        <button type="button" class="btn toggle-pass" tabindex="-1" title="Hiện/ẩn mật khẩu"><i class="fa-regular fa-eye"></i></button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-brand w-100 fw-bold py-2 rounded-3">
                    <i class="fa-solid fa-check me-1"></i> Đặt lại mật khẩu
                </button>
            </form>

            <div class="text-center mt-4 small">
                Chưa nhận được mã?
                <a asp-controller="Account" asp-action="ForgotPassword" class="text-brand fw-semibold text-decoration-none">Gửi lại mã</a>
            </div>
            <div class="text-center mt-2 small">
                <a asp-controller="Account" asp-action="Login" class="text-muted text-decoration-none"><i class="fa-solid fa-arrow-left me-1"></i>Quay lại đăng nhập</a>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        document.querySelectorAll('.toggle-pass').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = this.parentElement.querySelector('input');
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                this.querySelector('i').className = show ? 'fa-regular fa-eye-slash' : 'fa-regular fa-eye';
            });
        });
    </script>
</body>
</html>
