@model baitaplontmdtwebdatdoan.Models.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
    Layout = "_AuthLayout";
}

<div class="auth-head">
    <h1>Tạo tài khoản</h1>
    <p>Mất chưa tới một phút để bắt đầu đặt món.</p>
</div>

<form asp-controller="Account" asp-action="Register" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger auth-summary"></div>

    <div class="auth-field">
        <label asp-for="FullName"></label>
        <div class="auth-input">
            <i class="fa-regular fa-user"></i>
            <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" autocomplete="name" autofocus />
        </div>
        <span asp-validation-for="FullName" class="auth-error"></span>
    </div>

    <div class="auth-field">
        <label asp-for="Email">Email</label>
        <div class="auth-input">
            <i class="fa-regular fa-envelope"></i>
            <input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="email" />
        </div>
        <span asp-validation-for="Email" class="auth-error"></span>
    </div>

    <div class="auth-field">
        <label asp-for="Phone"></label>
        <div class="auth-input">
            <i class="fa-solid fa-phone"></i>
            <input asp-for="Phone" class="form-control" placeholder="0912345678" inputmode="tel" autocomplete="tel" />
        </div>
        <span asp-validation-for="Phone" class="auth-error"></span>
    </div>

    <div class="auth-field">
        <label asp-for="Password"></label>
        <div class="auth-input">
            <i class="fa-solid fa-lock"></i>
            <input asp-for="Password" class="form-control" placeholder="Tối thiểu 6 ký tự" autocomplete="new-password" />
            <button type="button" class="toggle-pass" tabindex="-1" aria-label="Hiện mật khẩu"><i class="fa-regular fa-eye"></i></button>
        </div>
        <div id="passStrength"><div id="passStrengthBar"></div></div>
        <div id="passStrengthText"></div>
        <span asp-validation-for="Password" class="auth-error"></span>
    </div>

    <div class="auth-field">
        <label asp-for="ConfirmPassword"></label>
        <div class="auth-input">
            <i class="fa-solid fa-lock"></i>
            <input asp-for="ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu" autocomplete="new-password" />
            <button type="button" class="toggle-pass" tabindex="-1" aria-label="Hiện mật khẩu"><i class="fa-regular fa-eye"></i></button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="auth-error"></span>
    </div>

    <div class="auth-field">
        <label>Bạn đăng ký với vai trò</label>
        <div class="role-grid">
            <label class="role-card">
                <input type="radio" name="Role" value="customer" @(Model.Role != "restaurant_owner" ? "checked" : "") />
                <span class="role-body">
                    <i class="fa-solid fa-bag-shopping"></i>
                    <span>
                        <span class="role-title d-block">Khách hàng</span>
                        <span class="role-sub d-block">Đặt món ăn</span>
                    </span>
                </span>
            </label>
            <label class="role-card">
                <input type="radio" name="Role" value="restaurant_owner" @(Model.Role == "restaurant_owner" ? "checked" : "") />
                <span class="role-body">
                    <i class="fa-solid fa-store"></i>
                    <span>
                        <span class="role-title d-block">Chủ nhà hàng</span>
                        <span class="role-sub d-block">Bán đồ ăn</span>
                    </span>
                </span>
            </label>
        </div>
    </div>

    <button type="submit" class="btn btn-brand auth-submit">Tạo tài khoản</button>
</form>

<p class="auth-alt">
    Đã có tài khoản?
    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl">Đăng nhập</a>
</p>
<a href="/" class="auth-back"><i class="fa-solid fa-arrow-left me-1"></i>Về trang chủ</a>

@section Scripts {
    <script>
        // Thanh đo độ mạnh mật khẩu (chỉ gợi ý, không chặn đăng ký)
        var passInput = document.getElementById('Password');
        var bar = document.getElementById('passStrengthBar');
        var txt = document.getElementById('passStrengthText');
        if (passInput) {
            passInput.addEventListener('input', function () {
                var v = passInput.value, score = 0;
                if (v.length >= 6) score++;
                if (v.length >= 10) score++;
                if (/[a-z]/.test(v) && /[A-Z]/.test(v)) score++;
                if (/\d/.test(v) && /[^A-Za-z0-9]/.test(v)) score++;
                if (!v) score = -1;
                var levels = [
                    { w: '25%', c: '#B3261E', t: 'Yếu' },
                    { w: '50%', c: '#E8590C', t: 'Trung bình' },
                    { w: '75%', c: '#E8A317', t: 'Khá' },
                    { w: '100%', c: '#1E7B4F', t: 'Mạnh' }
                ];
                var track = document.getElementById('passStrength');
                if (score < 0) { track.style.display = 'none'; bar.style.width = '0'; txt.textContent = ''; return; }
                track.style.display = 'block';
                var lv = levels[Math.min(Math.max(score - 1, 0), 3)];
                bar.style.width = lv.w; bar.style.background = lv.c; txt.textContent = 'Độ mạnh: ' + lv.t;
            });
        }
    </script>
}
