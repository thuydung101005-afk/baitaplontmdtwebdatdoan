@model List<baitaplontmdtwebdatdoan.Models.Restaurant>
@{
    ViewData["Title"] = "Nhà hàng";
}

<h4 class="fw-bold mb-4">TẤT CẢ NHÀ HÀNG</h4>

@if (!Model.Any())
{
    <p class="text-muted">Chưa có nhà hàng nào.</p>
}

<div class="row g-3">
    @foreach (var r in Model)
    {
        <div class="col-6 col-md-4 col-lg-3">
            <div class="card fd-card shadow-sm h-100 position-relative">
                <button type="button" class="btn btn-light btn-sm rounded-circle shadow-xs position-absolute top-0 end-0 m-2 toggle-fav-btn" 
                        data-restaurant-id="@r.Id" style="z-index:3; width:34px; height:34px;" title="Thêm vào yêu thích">
                    <i class="fa-regular fa-heart text-secondary"></i>
                </button>
                <a asp-controller="Restaurant" asp-action="Details" asp-route-id="@r.Id" class="text-decoration-none text-dark d-flex flex-column h-100">
                    <img src="@(string.IsNullOrEmpty(r.CoverImageUrl) ? "https://placehold.co/300x200?text=Restaurant" : r.CoverImageUrl)"
                         class="fd-card-img card-img-top" alt="@r.Name" 
                         onerror="this.src='https://placehold.co/300x200?text=Restaurant';" />
                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                        <div>
                            <h6 class="card-title text-truncate fw-bold mb-1">@r.Name</h6>
                            <div class="small text-muted mb-1">
                                <i class="fa-solid fa-star text-warning"></i> @(r.AvgRating > 0 ? r.AvgRating.ToString("0.0") : "5.0")
                                &middot; @r.PrepTimeMinutes phút
                            </div>
                        </div>
                        <div class="small text-muted text-truncate pt-2 border-top">
                            <i class="fa-solid fa-location-dot text-danger me-1"></i>@(string.IsNullOrEmpty(r.Address) ? "Foodie Center" : r.Address)
                        </div>
                    </div>
                </a>
            </div>
        </div>
    }
</div>