@model List<baitaplontmdtwebdatdoan.Models.Voucher>
@{
    ViewData["Title"] = "Quản lý & Phát hành Mã Giảm Giá (Voucher)";
    var isAdmin = (bool)(ViewBag.IsAdmin ?? false);
    var restaurants = ViewBag.Restaurants as List<baitaplontmdtwebdatdoan.Models.Restaurant> ?? new List<baitaplontmdtwebdatdoan.Models.Restaurant>();
    var now = DateTime.UtcNow;
}

<!-- HEADER -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="fa-solid fa-ticket text-brand me-2"></i>QUẢN LÝ & PHÁT HÀNH VOUCHER @(isAdmin ? "(TOÀN SÀN & ĐỐI TÁC)" : "(QUÁN CỦA TÔI)")
        </h4>
        <p class="text-muted small mb-0">
            Tạo chiến dịch mã giảm giá theo %, giảm tiền trực tiếp hoặc miễn phí vận chuyển để kích cầu đơn hàng
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Voucher" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-semibold">
            <i class="fa-solid fa-eye me-1"></i> Xem Kho Voucher Khách hàng
        </a>
        <button type="button" class="btn btn-brand btn-sm rounded-pill px-4 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#createVoucherModal">
            <i class="fa-solid fa-plus me-1"></i> Tạo Mã Giảm Giá Mới
        </button>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- BẢNG DANH SÁCH VOUCHER -->
<div class="bg-white rounded-4 shadow-sm p-4">
    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="fa-solid fa-ticket fs-1 mb-3 opacity-50"></i>
            <h6>Chưa có mã khuyến mãi nào</h6>
            <p class="small mb-3">Hãy bấm nút "Tạo Mã Giảm Giá Mới" để phát hành voucher thu hút khách hàng nhé!</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-muted text-uppercase">
                    <tr>
                        <th>Mã Voucher</th>
                        <th>Loại & Mức giảm</th>
                        <th>Phạm vi áp dụng</th>
                        <th>Đơn tối thiểu</th>
                        <th>Lượt sử dụng</th>
                        <th>Thời hạn</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Model)
                    {
                        int used = v.VoucherUsages?.Count ?? 0;
                        int limit = v.UsageLimit ?? 500;
                        bool isExpired = v.EndDate < now;

                        <tr>
                            <td>
                                <span class="badge bg-brand-subtle text-brand border border-brand font-monospace fs-6 px-2 py-1">@v.Code</span>
                                <div class="text-muted small mt-1" style="max-width:240px">@v.Description</div>
                            </td>
                            <td>
                                @if (v.DiscountType == "percent" || v.DiscountType == "percentage")
                                {
                                    <div class="fw-bold text-danger">Giảm @v.DiscountValue.ToString("0")%</div>
                                    if (v.MaxDiscount.HasValue)
                                    {
                                        <div class="text-muted small">Tối đa: @v.MaxDiscount.Value.ToString("N0")đ</div>
                                    }
                                }
                                else if (v.DiscountType == "free_shipping")
                                {
                                    <div class="fw-bold text-success">Freeship @v.DiscountValue.ToString("N0")đ</div>
                                }
                                else
                                {
                                    <div class="fw-bold text-primary">Giảm @v.DiscountValue.ToString("N0")đ</div>
                                }
                            </td>
                            <td>
                                @if (v.Restaurant != null)
                                {
                                    <span class="badge bg-info-subtle text-info-emphasis border border-info rounded-pill">
                                        <i class="fa-solid fa-store me-1"></i>@v.Restaurant.Name
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-dark border rounded-pill">
                                        <i class="fa-solid fa-globe me-1"></i>Toàn sàn Foodie
                                    </span>
                                }
                            </td>
                            <td class="fw-semibold">@v.MinOrderAmount.ToString("N0") ₫</td>
                            <td>
                                <div class="small fw-semibold">@used / @limit lượt</div>
                                <div class="text-muted" style="font-size:11px">Tối đa @v.UsageLimitPerUser lần/khách</div>
                            </td>
                            <td class="small">
                                <div>Từ: @v.StartDate.ToString("dd/MM/yyyy")</div>
                                <div class="@(isExpired ? "text-danger fw-bold" : "text-muted")">Đến: @v.EndDate.ToString("dd/MM/yyyy")</div>
                            </td>
                            <td class="text-center">
                                @if (!v.IsActive)
                                {
                                    <span class="badge bg-secondary rounded-pill">Đã tắt</span>
                                }
                                else if (isExpired)
                                {
                                    <span class="badge bg-danger rounded-pill">Hết hạn</span>
                                }
                                else
                                {
                                    <span class="badge bg-success rounded-pill">Đang chạy</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <form asp-action="ToggleActive" asp-route-id="@v.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm @(v.IsActive ? "btn-outline-warning" : "btn-outline-success") rounded-3" title="@(v.IsActive ? "Tạm dừng" : "Kích hoạt")">
                                            <i class="fa-solid @(v.IsActive ? "fa-pause" : "fa-play")"></i>
                                        </button>
                                    </form>
                                    <form asp-action="Delete" asp-route-id="@v.Id" method="post" onsubmit="return confirm('Xóa mã voucher @v.Code?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-3" title="Xóa">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- MODAL TẠO MỚI VOUCHER -->
<div class="modal fade" id="createVoucherModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold">
                    <i class="fa-solid fa-ticket text-brand me-2"></i>Phát hành Mã Giảm Giá Mới
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Voucher" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Mã Voucher (In hoa, viết liền) <span class="text-danger">*</span></label>
                            <input type="text" name="code" class="form-control text-uppercase font-monospace fw-bold" placeholder="VD: DEALHOT30, FREESHIP20..." required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Loại ưu đãi <span class="text-danger">*</span></label>
                            <select name="discountType" id="createDiscountType" class="form-select" onchange="toggleMaxDiscountField()">
                                <option value="fixed_amount">Giảm tiền trực tiếp (VNĐ)</option>
                                <option value="percent">Giảm theo phần trăm (%)</option>
                                <option value="free_shipping">Miễn phí vận chuyển (Freeship)</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label small fw-semibold">Mô tả chương trình khuyến mãi</label>
                            <input type="text" name="description" class="form-control" placeholder="VD: Giảm 30.000đ cho đơn hàng từ 100.000đ nhân dịp cuối tuần" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Giá trị giảm (% hoặc VNĐ) <span class="text-danger">*</span></label>
                            <input type="number" name="discountValue" class="form-control fw-bold" value="25000" min="1" required />
                        </div>
                        <div class="col-md-4" id="maxDiscountGroup">
                            <label class="form-label small fw-semibold">Giảm tối đa (VNĐ, nếu giảm %)</label>
                            <input type="number" name="maxDiscount" class="form-control" placeholder="VD: 50000" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Đơn hàng tối thiểu (VNĐ)</label>
                            <input type="number" name="minOrderAmount" class="form-control" value="80000" min="0" required />
                        </div>

                        @if (isAdmin)
                        {
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Phạm vi áp dụng</label>
                                <select name="restaurantId" class="form-select">
                                    <option value="0">🌐 Áp dụng Toàn Sàn Foodie</option>
                                    @foreach (var r in restaurants)
                                    {
                                        <option value="@r.Id">🏪 Chỉ áp dụng cho quán: @r.Name</option>
                                    }
                                </select>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" name="restaurantId" value="@(restaurants.FirstOrDefault()?.Id ?? 0)" />
                        }

                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Tổng lượt phát hành</label>
                            <input type="number" name="usageLimit" class="form-control" value="200" min="1" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Số lượt / 1 khách</label>
                            <input type="number" name="usageLimitPerUser" class="form-control" value="2" min="1" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Ngày bắt đầu</label>
                            <input type="date" name="startDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Ngày kết thúc</label>
                            <input type="date" name="endDate" class="form-control" value="@DateTime.Now.AddMonths(1).ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-light rounded-3 px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-brand fw-bold rounded-3 px-4">
                        <i class="fa-solid fa-check me-1"></i> Phát hành Voucher
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

