@{
    var isLoggedIn = User.Identity != null && User.Identity.IsAuthenticated;
    var displayName = User.Identity?.Name ?? "";

    // Chủ quán/admin vào hộp thư của quán, khách hàng vào hộp thư của mình
    var isShopStaff = isLoggedIn && (User.IsInRole("restaurant_owner") || User.IsInRole("admin"));
    var chatInboxAction = isShopStaff ? "ShopInbox" : "MyChats";

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#14402E" />
    <title>@ViewData["Title"] - Foodie</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- ===== HEADER ===== -->
    <header class="fd-header">
        <div class="fd-header-inner">
            <a class="fd-brand" href="/" aria-label="Foodie - về trang chủ">
                <span class="fd-brand-mark"><i class="fa-solid fa-utensils"></i></span>
                <span class="fd-brand-text">
                    <span class="fd-brand-name">Foodie</span>
                    <span class="fd-brand-tag">Ngon mỗi ngày!</span>
                </span>
            </a>

            <form asp-controller="Home" asp-action="Search" method="get" class="fd-search" role="search">
                <button type="submit" aria-label="Tìm kiếm"><i class="fa-solid fa-magnifying-glass"></i></button>
                <input type="text" name="q" value="@Context.Request.Query["q"]" placeholder="Tìm món ăn, nhà hàng..." aria-label="Tìm món ăn hoặc nhà hàng" />
            </form>

            <div class="fd-actions">
                <div class="fd-loc d-none d-xl-flex">
                    <i class="fa-solid fa-location-dot"></i>
                    <div>
                        <div class="fd-loc-label">Giao đến</div>
                        <div class="fd-loc-value">Chưa chọn địa chỉ <i class="fa-solid fa-chevron-down small ms-1"></i></div>
                    </div>
                </div>

                <a asp-controller="Cart" asp-action="Index" id="cartIcon" class="fd-cartbtn" aria-label="Giỏ hàng">
                    <i class="fa-solid fa-cart-shopping"></i>
                    <span class="fd-cartbtn-label">Giỏ hàng</span>
                    <span id="cartCountBadge" class="badge bg-brand rounded-pill position-absolute top-0 start-100 translate-middle" style="display:none">0</span>
                </a>

                <a asp-controller="Chat" asp-action="@chatInboxAction" id="chatIcon" title="Tin nhắn" aria-label="Tin nhắn" class="fd-iconbtn">
                    <i class="fa-regular fa-comments"></i>
                    <span id="chatCountBadge" class="badge bg-danger rounded-pill position-absolute top-0 start-100 translate-middle" style="display:none">0</span>
                </a>

                <button type="button" class="fd-iconbtn d-none d-sm-grid" aria-label="Thông báo"><i class="fa-regular fa-bell"></i></button>

                @if (isLoggedIn)
                {
                    <div class="dropdown">
                        <button type="button" class="fd-user" data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(string.IsNullOrWhiteSpace(displayName) ? "U" : displayName)&background=14402E&color=fff&bold=true" width="38" height="38" alt="Ảnh đại diện" />
                            <span class="fd-user-text d-none d-md-block">
                                <span class="fd-user-hello d-block">Xin chào,</span>
                                <span class="fd-user-name d-block">@displayName</span>
                            </span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm rounded-3">
                            <li>
                                <a class="dropdown-item fw-semibold" asp-controller="Account" asp-action="Profile">
                                    <i class="fa-regular fa-user me-2 text-brand"></i>Thông tin tài khoản
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            @if (User.IsInRole("admin"))
                            {
                                <li>
                                    <a class="dropdown-item" asp-controller="Admin" asp-action="Index">
                                        <i class="fa-solid fa-shield-halved me-2"></i>Quản trị hệ thống
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                            }
                            @if (User.IsInRole("restaurant_owner"))
                            {
                                <li>
                                    <a class="dropdown-item" asp-controller="RestaurantOwner" asp-action="Orders">
                                        <i class="fa-solid fa-receipt me-2"></i>Quản lý đơn hàng
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="RestaurantOwner" asp-action="Menu">
                                        <i class="fa-solid fa-utensils me-2"></i>Quản lý thực đơn
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="RestaurantOwner" asp-action="Revenue">
                                        <i class="fa-solid fa-chart-line me-2 text-success"></i>Doanh thu và hoa hồng
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Chat" asp-action="ShopInbox">
                                        <i class="fa-regular fa-comments me-2 text-primary"></i>Tin nhắn khách hàng
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="RestaurantOwner" asp-action="Settings">
                                        <i class="fa-solid fa-gear me-2 text-secondary"></i>Hồ sơ & ảnh nhà hàng
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                            }
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="fa-solid fa-right-from-bracket me-2"></i>Đăng xuất
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary btn-sm ms-1">Đăng nhập</a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-brand btn-sm">Đăng ký</a>
                }
            </div>
        </div>
    </header>

    <!-- ===== BODY ===== -->
    <div class="fd-shell">
        <!-- Thanh điều hướng -->
        <aside class="fd-rail">
            <nav class="fd-rail-nav" aria-label="Điều hướng chính">
                <a class="fd-navlink @(currentController == "Home" ? "active" : "")" aria-current="@(currentController == "Home" ? "page" : null)" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house"></i>Trang chủ</a>
                <a class="fd-navlink @(currentController == "Menu" ? "active" : "")" aria-current="@(currentController == "Menu" ? "page" : null)" asp-controller="Menu" asp-action="Index"><i class="fa-solid fa-border-all"></i>Danh mục món ăn</a>
                <a class="fd-navlink @(currentController == "Restaurant" ? "active" : "")" aria-current="@(currentController == "Restaurant" ? "page" : null)" asp-controller="Restaurant" asp-action="Index"><i class="fa-solid fa-store"></i>Nhà hàng</a>
                <a class="fd-navlink @(currentController == "Voucher" ? "active" : "")" aria-current="@(currentController == "Voucher" ? "page" : null)" asp-controller="Voucher" asp-action="Index"><i class="fa-solid fa-tags"></i>Khuyến mãi</a>
                <a class="fd-navlink @(currentController == "Favorite" ? "active" : "")" aria-current="@(currentController == "Favorite" ? "page" : null)" asp-controller="Favorite" asp-action="Index">
                    <i class="fa-solid fa-heart"></i>Yêu thích
                    <span id="favCountBadge" class="badge bg-brand rounded-pill" style="display:none;font-size:11px">0</span>
                </a>
                <a class="fd-navlink @(currentController == "Follow" ? "active" : "")" aria-current="@(currentController == "Follow" ? "page" : null)" asp-controller="Follow" asp-action="MyFollows"><i class="fa-solid fa-bell"></i>Đang theo dõi</a>
                <a class="fd-navlink @(currentController == "Order" ? "active" : "")" aria-current="@(currentController == "Order" ? "page" : null)" asp-controller="Order" asp-action="MyOrders"><i class="fa-regular fa-clipboard"></i>Đơn hàng của tôi</a>
            </nav>

            <div class="fd-support">
                <div class="fd-support-title">Hỗ trợ khách hàng</div>
                <div class="fd-support-row"><i class="fa-solid fa-phone"></i>1900 1234</div>
                <div class="fd-support-row"><i class="fa-regular fa-envelope"></i>hotro@foodie.vn</div>
                <div class="fd-support-row"><i class="fa-regular fa-clock"></i>8:00 - 22:00 (T2 - CN)</div>
            </div>
        </aside>

        <!-- Nội dung chính -->
        <main class="fd-main">
            @RenderBody()
        </main>
    </div>

    <!-- ===== FOOTER ===== -->
    <footer class="fd-footer">
        <div class="fd-perks">
            <div class="fd-perk"><span class="fd-perk-icon"><i class="fa-solid fa-truck-fast"></i></span><div><div class="fd-perk-title">Giao hàng nhanh chóng</div><div class="fd-perk-sub">30-60 phút</div></div></div>
            <div class="fd-perk"><span class="fd-perk-icon"><i class="fa-regular fa-credit-card"></i></span><div><div class="fd-perk-title">Thanh toán đa dạng</div><div class="fd-perk-sub">COD, Ví, Thẻ, Chuyển khoản</div></div></div>
            <div class="fd-perk"><span class="fd-perk-icon"><i class="fa-solid fa-rotate"></i></span><div><div class="fd-perk-title">Đổi trả dễ dàng</div><div class="fd-perk-sub">Trong vòng 24h</div></div></div>
            <div class="fd-perk"><span class="fd-perk-icon"><i class="fa-solid fa-gift"></i></span><div><div class="fd-perk-title">Ưu đãi mỗi ngày</div><div class="fd-perk-sub">Nhiều khuyến mãi hấp dẫn</div></div></div>
            <div class="fd-perk"><span class="fd-perk-icon"><i class="fa-solid fa-headset"></i></span><div><div class="fd-perk-title">Hỗ trợ 24/7</div><div class="fd-perk-sub">1900 1234</div></div></div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
